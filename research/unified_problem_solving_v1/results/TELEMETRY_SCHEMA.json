{
  "schema_version": "orion-telemetry-v1",
  "grants_scientific_authority": false,
  "fields": {
    "schema_version": {
      "name": "schema_version",
      "description": "Version identifier for the result schema format",
      "requirement": "required",
      "dtype": "string",
      "examples": [
        "orion-telemetry-v1",
        "paper2-a3-a4-matched-empirics-156-harvest-receipt-v1"
      ]
    },
    "grants_scientific_authority": {
      "name": "grants_scientific_authority",
      "description": "Whether this result grants scientific authority (default false)",
      "requirement": "required",
      "dtype": "boolean",
      "examples": [
        "false",
        "true"
      ]
    },
    "seeds": {
      "name": "seeds",
      "description": "Random seeds used for reproducibility (single value or array)",
      "requirement": "optional",
      "dtype": "object",
      "examples": [
        "42",
        "[42, 123, 456]",
        "seed"
      ]
    },
    "n": {
      "name": "n",
      "description": "Sample size or number of independent units",
      "requirement": "optional",
      "dtype": "number",
      "examples": [
        "100",
        "n_completed",
        "n_scenarios"
      ]
    },
    "independent_unit": {
      "name": "independent_unit",
      "description": "What constitutes an independent observation (e.g., scenario, query, graph)",
      "requirement": "optional",
      "dtype": "string",
      "examples": [
        "scenario",
        "query",
        "graph",
        "claim"
      ]
    },
    "verified_success": {
      "name": "verified_success",
      "description": "Fraction of outcomes verified as successful (or boolean for single trial)",
      "requirement": "optional",
      "dtype": "object",
      "examples": [
        "0.85",
        "true",
        "valid_upgrade_recall",
        "success_rate"
      ]
    },
    "false_accept_rate": {
      "name": "false_accept_rate",
      "description": "Rate at which the system accepts false positives (Type I error)",
      "requirement": "optional",
      "dtype": "number",
      "examples": [
        "0.05",
        "0.12",
        "false_conservative_refusal_rate"
      ]
    },
    "tokens_in": {
      "name": "tokens_in",
      "description": "Total input tokens processed (prompt tokens)",
      "requirement": "optional",
      "dtype": "number",
      "examples": [
        "12500",
        "tokens_prompt",
        "input_tokens"
      ]
    },
    "tokens_out": {
      "name": "tokens_out",
      "description": "Total output tokens generated (completion tokens)",
      "requirement": "optional",
      "dtype": "number",
      "examples": [
        "3200",
        "tokens_completion",
        "output_tokens"
      ]
    },
    "model_calls": {
      "name": "model_calls",
      "description": "Number of model API calls made",
      "requirement": "optional",
      "dtype": "number",
      "examples": [
        "45",
        "n_calls",
        "api_calls"
      ]
    },
    "tool_calls": {
      "name": "tool_calls",
      "description": "Number of tool/function calls invoked",
      "requirement": "optional",
      "dtype": "number",
      "examples": [
        "12",
        "n_tool_calls"
      ]
    },
    "verifier_calls": {
      "name": "verifier_calls",
      "description": "Number of verification calls made",
      "requirement": "optional",
      "dtype": "number",
      "examples": [
        "8",
        "verification_calls"
      ]
    },
    "states_expanded": {
      "name": "states_expanded",
      "description": "Number of states/nodes expanded during search",
      "requirement": "optional",
      "dtype": "number",
      "examples": [
        "1250",
        "baseline_expanded",
        "field_expanded",
        "nodes_visited"
      ]
    },
    "wall_time_s": {
      "name": "wall_time_s",
      "description": "Wall-clock execution time in seconds",
      "requirement": "optional",
      "dtype": "number",
      "examples": [
        "12.5",
        "wall_time",
        "elapsed_time"
      ]
    },
    "cpu_time_s": {
      "name": "cpu_time_s",
      "description": "CPU time consumed in seconds",
      "requirement": "uncomputable",
      "dtype": "number",
      "examples": [
        "10.2",
        "cpu_time",
        "cputime",
        "cpu"
      ]
    },
    "gpu_time_s": {
      "name": "gpu_time_s",
      "description": "GPU time consumed in seconds",
      "requirement": "uncomputable",
      "dtype": "number",
      "examples": [
        "8.5",
        "gpu_time",
        "gputime"
      ]
    },
    "ram_peak_mb": {
      "name": "ram_peak_mb",
      "description": "Peak RAM usage in megabytes",
      "requirement": "uncomputable",
      "dtype": "number",
      "examples": [
        "4096",
        "maxrss",
        "memory_mb",
        "ram_peak"
      ]
    },
    "vram_peak_mb": {
      "name": "vram_peak_mb",
      "description": "Peak VRAM usage in megabytes",
      "requirement": "uncomputable",
      "dtype": "number",
      "examples": [
        "2048",
        "vram",
        "gpu_mem_mb",
        "vram_peak"
      ]
    },
    "provider_cost_usd": {
      "name": "provider_cost_usd",
      "description": "Total provider API cost in USD",
      "requirement": "optional",
      "dtype": "number",
      "examples": [
        "0.45",
        "cost_usd",
        "api_cost",
        "total_cost"
      ]
    },
    "construction_cost": {
      "name": "construction_cost",
      "description": "Cost to construct the field/structure (may include confidence interval)",
      "requirement": "optional",
      "dtype": "object",
      "examples": [
        "{mean: 0.12, lo: 0.10, hi: 0.14, n: 100}",
        "build_cost"
      ]
    },
    "verification_cost": {
      "name": "verification_cost",
      "description": "Cost to verify claims/hypotheses",
      "requirement": "optional",
      "dtype": "number",
      "examples": [
        "0.08",
        "verification_cost_total"
      ]
    },
    "cache_hit": {
      "name": "cache_hit",
      "description": "Number of cache hits (or hit rate)",
      "requirement": "optional",
      "dtype": "object",
      "examples": [
        "45",
        "0.78",
        "cache_hits",
        "hit_rate"
      ]
    },
    "cache_miss": {
      "name": "cache_miss",
      "description": "Number of cache misses (or miss rate)",
      "requirement": "optional",
      "dtype": "object",
      "examples": [
        "12",
        "0.22",
        "cache_misses",
        "miss_rate"
      ]
    }
  },
