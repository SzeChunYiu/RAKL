{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper5-independent-novelty-blocked-human-freeze-v1.schema.json",
  "title": "Paper 5 independent novelty-audit BLOCKED_HUMAN freeze",
  "description": "Versioned independent-human residual freeze after #255 demoted AI_OPERATOR closeout. Real humans only; demoted track is not independent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "freeze_id",
    "parent_issue",
    "successor_issue",
    "freeze_status",
    "terminal_status",
    "scientific_verdict",
    "created_at_utc",
    "base_main_sha",
    "human_roles_required",
    "human_roles_assigned",
    "humans_invented",
    "independent_external_human",
    "independent_review_claimed",
    "confirmatory_authority",
    "grants_scientific_authority",
    "promotional_lift_claim_allowed",
    "constitution_grade_independent_peer_review",
    "acceptance_assessment",
    "phase0_substrate",
    "demoted_track_non_authority",
    "blockers",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "paper5-independent-novelty-blocked-human-freeze-v1"
    },
    "freeze_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_issue": {
      "const": 255
    },
    "successor_issue": {
      "type": "integer",
      "minimum": 1
    },
    "audit_id": {
      "type": "string",
      "minLength": 1
    },
    "audit_epoch_id": {
      "type": "string",
      "minLength": 1
    },
    "freeze_status": {
      "const": "BLOCKED_HUMAN"
    },
    "terminal_status": {
      "const": "CANNOT_OBTAIN_INDEPENDENT_EXTERNAL_HUMANS"
    },
    "scientific_verdict": {
      "const": "DEMOTED_AI_OPERATOR_PATH_COMPLETE__INDEPENDENT_NOVELTY_AUDIT_ABSENT"
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "base_main_sha": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "protocol_path": {
      "type": "string",
      "minLength": 1
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "human_roles_required": {
      "type": "array",
      "minItems": 4,
      "items": {
        "enum": [
          "annotator_A",
          "annotator_B",
          "adjudicator",
          "provenance_auditor"
        ]
      },
      "uniqueItems": true
    },
    "human_roles_assigned": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotator_A",
        "annotator_B",
        "adjudicator",
        "provenance_auditor"
      ],
      "properties": {
        "annotator_A": {
          "type": [
            "string",
            "null"
          ]
        },
        "annotator_B": {
          "type": [
            "string",
            "null"
          ]
        },
        "adjudicator": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance_auditor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "humans_invented": {
      "const": false
    },
    "independent_external_human": {
      "const": false
    },
    "independent_review_claimed": {
      "const": false
    },
    "confirmatory_authority": {
      "const": false
    },
    "grants_scientific_authority": {
      "const": false
    },
    "promotional_lift_claim_allowed": {
      "const": false
    },
    "constitution_grade_independent_peer_review": {
      "const": false
    },
    "acceptance_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_annotator_a_present",
        "independent_annotator_b_present",
        "distinct_external_adjudicator_present",
        "distinct_external_provenance_auditor_present",
        "independent_public_audit_packet_released",
        "independent_sample_plan_frozen_for_humans",
        "independent_labels_present",
        "demoted_ai_operator_artifacts_present",
        "demoted_track_treated_as_independent",
        "constitution_grade_independent_review_claimed"
      ],
      "properties": {
        "independent_annotator_a_present": {
          "const": false
        },
        "independent_annotator_b_present": {
          "const": false
        },
        "distinct_external_adjudicator_present": {
          "const": false
        },
        "distinct_external_provenance_auditor_present": {
          "const": false
        },
        "independent_public_audit_packet_released": {
          "const": false
        },
        "independent_sample_plan_frozen_for_humans": {
          "const": false
        },
        "independent_labels_present": {
          "const": false
        },
        "demoted_ai_operator_artifacts_present": {
          "type": "boolean"
        },
        "demoted_track_treated_as_independent": {
          "const": false
        },
        "constitution_grade_independent_review_claimed": {
          "const": false
        }
      }
    },
    "phase0_substrate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_universe_manifest_path",
        "audit_universe_manifest_sha256",
        "zero_external_novelty_labels_path",
        "zero_external_novelty_labels_sha256",
        "blinded_audit_candidate_frame_path",
        "blinded_audit_candidate_frame_sha256"
      ],
      "properties": {
        "audit_universe_manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "audit_universe_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "zero_external_novelty_labels_path": {
          "type": "string",
          "minLength": 1
        },
        "zero_external_novelty_labels_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "blinded_audit_candidate_frame_path": {
          "type": "string",
          "minLength": 1
        },
        "blinded_audit_candidate_frame_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "audit_freeze_stub_path": {
          "type": "string",
          "minLength": 1
        },
        "audit_freeze_stub_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "demoted_track_non_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "authority_class",
        "may_satisfy_this_issue"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "completion_path": {
          "type": "string",
          "minLength": 1
        },
        "completion_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "final_receipt_path": {
          "type": "string",
          "minLength": 1
        },
        "final_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "honesty_stamp_path": {
          "type": "string",
          "minLength": 1
        },
        "honesty_stamp_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authority_class": {
          "const": "DEMOTED_AI_OPERATOR_NON_INDEPENDENT"
        },
        "may_satisfy_this_issue": {
          "const": false
        }
      }
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "class",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "enum": [
              "BLOCKED_HUMAN",
              "TRACK_SEPARATION",
              "RELATED_ISSUE"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "operator_policy": {
      "type": "string",
      "minLength": 1
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "residual_authorization": {
      "type": "string",
      "minLength": 1
    },
    "related_artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
