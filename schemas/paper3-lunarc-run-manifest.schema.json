{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rakl/paper3-lunarc-run-manifest.schema.json",
  "title": "Paper 3 LUNARC run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "workload", "subject_sha", "gate_receipt_sha256", "protocol_path", "protocol_sha256", "benchmark_path", "benchmark_sha256", "annotation_import_receipt_path", "annotation_import_receipt_sha256", "task_set_path", "task_set_sha256", "model_revision", "model_artifact_path", "model_artifact_sha256", "environment_path", "environment_sha256", "seed_schedule_path", "seed_schedule_sha256", "account", "partition", "fs9_output_dir", "batch_script", "batch_script_sha256", "repo_path", "manifest_path", "gate_receipt_path"],
  "properties": {
    "schema_version": {"const": "paper3-lunarc-run-manifest-v1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "workload": {"enum": ["training", "inference"]},
    "subject_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gate_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_path": {"type": "string", "pattern": "^/"},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "benchmark_path": {"type": "string", "pattern": "^/"},
    "benchmark_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "annotation_import_receipt_path": {"type": "string", "pattern": "^/"},
    "annotation_import_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_set_path": {"type": "string", "pattern": "^/"},
    "task_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_revision": {"type": "string", "pattern": "^[^@\\s]+@[0-9a-f]{40}$"},
    "model_artifact_path": {"type": "string", "pattern": "^/"},
    "model_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_path": {"type": "string", "pattern": "^/"},
    "environment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "seed_schedule_path": {"type": "string", "pattern": "^/"},
    "seed_schedule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "account": {"const": "lu2026-2-51"},
    "partition": {"enum": ["gpua100", "gpua100i", "gpua40", "gpua40i"]},
    "fs9_output_dir": {"type": "string", "pattern": "^/projects/hep/fs9/users/scyiu/RAKL-paper3/[^/]+$"},
    "batch_script": {"type": "string", "pattern": "\\.sbatch$"},
    "batch_script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repo_path": {"type": "string", "pattern": "^/[^\\u0000]+$"},
    "manifest_path": {"type": "string", "minLength": 1},
    "gate_receipt_path": {"type": "string", "minLength": 1}
  }
}
