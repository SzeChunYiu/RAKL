{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/solver_view.schema.json",
  "title": "ORION SnapshotBoundSolverView",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_snapshot_id",
    "problem_id",
    "target_id",
    "support_structure_id",
    "compiler_identity",
    "required_authority",
    "atom_ids",
    "relation_ids",
    "chart_ids",
    "obstruction_ids",
    "source_evidence_ids",
    "view_id"
  ],
  "properties": {
    "project_snapshot_id": {
      "type": "string",
      "pattern": "^snapshot:[0-9a-f]{64}$"
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "support_structure_id": {
      "type": "string",
      "minLength": 1
    },
    "compiler_identity": {
      "type": "string",
      "minLength": 1
    },
    "required_authority": {
      "type": "integer",
      "minimum": 0
    },
    "atom_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relation_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "chart_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "obstruction_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "view_id": {
      "type": "string",
      "pattern": "^solver-view:[0-9a-f]{64}$"
    }
  }
}
