{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/knowledge-fiber.schema.json",
  "title": "RAKL Knowledge Fiber",
  "type": "object",
  "required": [
    "fiber_id",
    "object_id",
    "atomic_step",
    "status",
    "dimensions",
    "projections",
    "relationships",
    "gaps",
    "next_discriminators"
  ],
  "properties": {
    "fiber_id": {"type": "string", "minLength": 1},
    "object_id": {"type": "string", "minLength": 1},
    "parent_fiber_id": {"type": ["string", "null"]},
    "atomic_step": {"type": "string", "minLength": 1},
    "question": {"type": ["string", "null"]},
    "qoi": {"type": ["string", "null"]},
    "status": {
      "enum": [
        "UNSEARCHED",
        "SEARCHING",
        "NON_FLAT",
        "FLAT_SAME_CONTEXT",
        "INDEPENDENT_FLAT_1",
        "INDEPENDENT_FLAT_2",
        "INDEPENDENT_FLAT_3",
        "SATURATED_SCOPED",
        "REOPENED_BY_RESIDUAL"
      ]
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "observables": {"type": "array", "items": {"type": "string"}},
        "representations": {"type": "array", "items": {"type": "string"}},
        "microscopic_mechanisms": {"type": "array", "items": {"type": "string"}},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "scales_regimes": {"type": "array", "items": {"type": "string"}},
        "observation_models": {"type": "array", "items": {"type": "string"}},
        "coarse_graining_operators": {"type": "array", "items": {"type": "string"}},
        "inference_methods": {"type": "array", "items": {"type": "string"}},
        "numerical_methods": {"type": "array", "items": {"type": "string"}},
        "falsifiers_counterexamples": {"type": "array", "items": {"type": "string"}},
        "native_data_products": {"type": "array", "items": {"type": "string"}},
        "qois": {"type": "array", "items": {"type": "string"}},
        "decision_consumers": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "projections": {
      "type": "array",
      "items": {"type": "string"}
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["left", "right", "relationship"],
        "properties": {
          "left": {"type": "string"},
          "right": {"type": "string"},
          "relationship": {
            "enum": [
              "COMPLEMENTARY",
              "EXACT_ISOMORPHISM",
              "GENERATOR_EQUIVALENCE",
              "OBSERVATIONAL_EQUIVALENCE",
              "ASYMPTOTIC_EQUIVALENCE",
              "QOI_EQUIVALENCE",
              "APPROXIMATE_REPRESENTATION",
              "CONTEXT_DEPENDENT_DIFFERENCE",
              "CONTRADICTION",
              "ANALOGY_ONLY",
              "INCOMPATIBLE",
              "UNKNOWN"
            ]
          },
          "scope": {"type": ["string", "null"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "compatibility_constraints": {
      "type": "array",
      "items": {"type": "string"}
    },
    "surviving_hypotheses": {
      "type": "array",
      "items": {"type": "string"}
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap_id", "kind", "description"],
        "properties": {
          "gap_id": {"type": "string"},
          "kind": {
            "enum": [
              "MISSING_FACET",
              "MISSING_CONTEXT",
              "CONTRADICTION",
              "IDENTIFIABILITY",
              "MISSING_DATA",
              "MECHANISM_GAP",
              "DERIVATION_GAP",
              "NUMERICAL_GAP",
              "DECISION_GAP",
              "METHOD_GAP"
            ]
          },
          "description": {"type": "string"},
          "reopens_dimensions": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "next_discriminators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "hypotheses", "prediction_frozen", "cost"],
        "properties": {
          "id": {"type": "string"},
          "hypotheses": {"type": "array", "items": {"type": "string"}},
          "prediction_frozen": {"type": "boolean"},
          "separation_score": {"type": ["number", "null"]},
          "identified_set_shrinkage": {"type": ["number", "null"]},
          "cost": {"type": "number", "exclusiveMinimum": 0},
          "required_data": {"type": "array", "items": {"type": "string"}},
          "result_branches": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "research_rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["round_id", "context_id", "new_semantic_objects"],
        "properties": {
          "round_id": {"type": "string"},
          "context_id": {"type": "string"},
          "new_semantic_objects": {"type": "array", "items": {"type": "string"}},
          "flat_after_dedup": {"type": "boolean"},
          "independent": {"type": "boolean"}
        }
      }
    },
    "residual_signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["residual_id", "kinds", "description"],
        "properties": {
          "residual_id": {"type": "string", "minLength": 1},
          "kinds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "DISTRIBUTION", "TEMPORAL", "REGIME", "TAIL", "VOLATILITY",
                "CROSS_ASSET", "CROSS_VENUE", "FLOW_LIQUIDITY", "OBSERVATION",
                "CLOCK", "CAUSAL", "IDENTIFIABILITY", "CALIBRATION", "TRANSPORT",
                "PREDICTIVE", "UNCLASSIFIED"
              ]
            }
          },
          "description": {"type": "string", "minLength": 1},
          "implicated_fiber_ids": {"type": "array", "items": {"type": "string"}},
          "failed_candidate_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "diagnostics": {"type": "object", "additionalProperties": {"type": ["number", "string"]}}
        },
        "additionalProperties": false
      }
    },
    "formalism_candidate_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "invention_moves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["move_id", "operator", "rationale", "residual_ids"],
        "properties": {
          "move_id": {"type": "string", "minLength": 1},
          "operator": {
            "enum": [
              "COMPOSE", "RECOMBINE", "ADD_LATENT_STATE", "REMOVE_LATENT_STATE",
              "SPLIT_REGIME", "MERGE_REGIME", "CHANGE_CLOCK", "COARSE_GRAIN",
              "FINE_GRAIN", "GENERALIZE", "SPECIALIZE", "TAKE_LIMIT", "DUALIZE",
              "STOCHASTICIZE", "DETERMINIZE", "ADD_FEEDBACK", "REMOVE_FEEDBACK",
              "ADD_COUPLING", "REMOVE_COUPLING", "ADD_INTERACTION", "RELAX_ASSUMPTION",
              "STRENGTHEN_ASSUMPTION", "ADD_INVARIANT", "BREAK_SYMMETRY", "ADD_SYMMETRY",
              "NONLINEARIZE", "LINEARIZE", "IMPORT_ANALOGICAL_MOTIF",
              "CHANGE_OBSERVATION_MAP", "EXPLAIN_RESIDUAL"
            ]
          },
          "rationale": {"type": "string", "minLength": 1},
          "residual_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_fiber_ids": {"type": "array", "items": {"type": "string"}},
          "source_witness_ids": {"type": "array", "items": {"type": "string"}},
          "declared_before_evaluation": {"type": ["boolean", "null"]}
        },
        "additionalProperties": true
      }
    },
    "candidate_frontier": {
      "type": "array",
      "items": {"type": "string"}
    },
    "positive_goal_contract": {
      "type": "object",
      "required": [
        "contract_id",
        "min_descriptive_coverage",
        "min_residual_closure",
        "min_predictive_value",
        "min_identification",
        "min_falsifiability",
        "min_robustness",
        "negative_results_terminal"
      ],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "min_descriptive_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "min_residual_closure": {"type": "number", "minimum": 0, "maximum": 1},
        "min_predictive_value": {"type": "number", "minimum": 0, "maximum": 1},
        "min_identification": {"type": "number", "minimum": 0, "maximum": 1},
        "min_falsifiability": {"type": "number", "minimum": 0, "maximum": 1},
        "min_robustness": {"type": "number", "minimum": 0, "maximum": 1},
        "max_complexity": {"type": ["number", "null"], "minimum": 0},
        "verification_required": {"type": "boolean"},
        "thresholds_frozen_before_results": {"type": ["boolean", "null"]},
        "negative_results_terminal": {"const": false}
      },
      "additionalProperties": false
    },
    "goal_status": {
      "enum": ["SEARCHING", "GOAL_ACHIEVED", "CANNOT_CHECK", "BLOCKED_INTEGRITY"]
    }
  },
  "additionalProperties": true
}
