{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakl.invalid/schemas/paper5-attribution-run-v1.schema.json",
  "title": "Paper 5 normalized attribution run record",
  "description": "One arm/repetition result for the prospective four-arm Paper 5 attribution study. Schema validity grants no empirical or promotion claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "task_id",
    "repetition",
    "arm",
    "success",
    "score",
    "state_before_hash",
    "state_after_hash",
    "output_hash",
    "validity_failures",
    "failure_signature",
    "model_input_tokens",
    "model_output_tokens",
    "preprocessing_model_tokens",
    "tool_calls",
    "retrieval_calls",
    "wall_time_ms"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "repetition": {"type": "integer", "minimum": 1},
    "arm": {
      "enum": ["MODEL_ONLY", "RAKL_RESET", "RAKL_SHAM_MEMORY", "RAKL_LEARNING"]
    },
    "success": {"type": "boolean"},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "state_before_hash": {"type": "string", "minLength": 1},
    "state_after_hash": {"type": "string", "minLength": 1},
    "output_hash": {"type": "string", "minLength": 1},
    "validity_failures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "failure_signature": {"type": "array", "items": {"type": "string"}},
    "model_input_tokens": {"type": "integer", "minimum": 0},
    "model_output_tokens": {"type": "integer", "minimum": 0},
    "preprocessing_model_tokens": {"type": "integer", "minimum": 0},
    "tool_calls": {"type": "integer", "minimum": 0},
    "retrieval_calls": {"type": "integer", "minimum": 0},
    "wall_time_ms": {"type": "integer", "minimum": 0},
    "false_transfer": {"type": ["boolean", "null"]},
    "repeated_failure": {"type": ["boolean", "null"]},
    "memory_changed_action": {"type": ["boolean", "null"]},
    "unsupported_scope_escalation": {"type": ["boolean", "null"]},
    "root_coordinate_surrogate_error": {"type": ["boolean", "null"]},
    "local_global_gluing_failure": {"type": ["boolean", "null"]},
    "request_timestamp_utc": {"type": ["string", "null"], "format": "date-time"},
    "model_response_metadata_hash": {"type": ["string", "null"]}
  }
}
