{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/self_model_snapshot.schema.json",
  "title": "SelfModelSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["self_model_hash", "genome_hash", "evaluation_epoch_id", "episode_cutoff_hash", "context_signature"],
  "properties": {
    "self_model_hash": {"$ref": "#/$defs/sha256"},
    "genome_hash": {"$ref": "#/$defs/sha256"},
    "evaluation_epoch_id": {"type": "string", "minLength": 1},
    "episode_cutoff_hash": {"$ref": "#/$defs/sha256"},
    "context_signature": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
