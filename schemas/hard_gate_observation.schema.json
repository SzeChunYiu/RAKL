{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakl.dev/schemas/hard_gate_observation.schema.json",
  "title": "HardGateObservation",
  "type": "object",
  "additionalProperties": false,
  "required": ["gate_id", "status", "metric_receipt_ids"],
  "properties": {
    "gate_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
    "metric_receipt_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reason": {"type": "string"}
  }
}
