{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper5-confirmatory-packet-freeze-stub-v1.schema.json",
  "title": "Paper 5 confirmatory four-arm packet freeze stub",
  "description": "Inventory and blocker receipt for the Paper-V confirmatory packet (#250). This stub MUST NOT emit CONFIRMATORY_PACKET_FROZEN_AND_EXECUTABLE. It grants no scientific authority and authorizes zero confirmatory outcome access.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "issue",
    "status",
    "required_artifacts",
    "artifact_status",
    "blockers",
    "handoff_status",
    "grants_scientific_authority",
    "claim_boundary",
    "evaluated_results_accessed"
  ],
  "properties": {
    "schema_version": {"const": "paper5-confirmatory-packet-freeze-stub-v1"},
    "packet_id": {"type": "string", "minLength": 1},
    "issue": {"const": 250},
    "status": {
      "enum": [
        "PACKET_STUB_ONLY",
        "PACKET_PARTIALLY_ASSEMBLED",
        "BLOCKED_AWAITING_UPSTREAM"
      ]
    },
    "required_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "artifact_status": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": ["MISSING", "DESIGN_ONLY", "STUB", "FROZEN", "BLOCKED"]
      }
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "detail"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "class": {
            "enum": [
              "LEARNING_SEMANTICS",
              "MODEL_CAPABILITY_GATE",
              "PROVIDER_ADAPTER",
              "TASK_PACKET",
              "SHAM_POLICY",
              "RESOURCE_CEILING",
              "LUNARC_COMPUTE",
              "UPSTREAM_ISSUE"
            ]
          },
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "handoff_status": {
      "const": "NOT_CONFIRMATORY_PACKET_FROZEN_AND_EXECUTABLE"
    },
    "grants_scientific_authority": {"const": false},
    "claim_boundary": {"type": "string", "minLength": 1},
    "evaluated_results_accessed": {"const": false}
  }
}
