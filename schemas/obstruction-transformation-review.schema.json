{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/obstruction-transformation-review.schema.json",
  "title": "RAKL Obstruction-Transformation Semantic Shortcut Review",
  "description": "Frozen proposal-only SEARCH -> JUMP -> GLUE -> LIFT route review. Runtime auditing enforces invention-last mode semantics and target-validation obligations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "target_atom_id",
    "target_context_hash",
    "research_memory_review_hash",
    "episode_memory_snapshot_hash",
    "obstruction",
    "direct_search_status",
    "jump_search_status",
    "glue_search_status",
    "selected_mode",
    "evidence_pointers",
    "artifact_hash"
  ],
  "properties": {
    "review_id": {"type": "string", "minLength": 1},
    "target_atom_id": {"type": "string", "minLength": 1},
    "target_context_hash": {"type": "string", "minLength": 1},
    "research_memory_review_hash": {"type": "string", "minLength": 1},
    "episode_memory_snapshot_hash": {"type": "string", "minLength": 1},
    "obstruction": {"$ref": "#/$defs/obstructionFingerprint"},
    "direct_search_status": {"$ref": "#/$defs/searchStatus"},
    "jump_search_status": {"$ref": "#/$defs/searchStatus"},
    "glue_search_status": {"$ref": "#/$defs/searchStatus"},
    "selected_mode": {
      "enum": ["SEARCH", "JUMP", "GLUE", "LIFT", "CANNOT_CHECK"]
    },
    "direct_candidate_episode_ids": {"$ref": "#/$defs/stringArray"},
    "jump_mapping_witnesses": {
      "type": "array",
      "items": {"$ref": "#/$defs/structuralMappingWitness"},
      "default": []
    },
    "glue_witness": {
      "oneOf": [
        {"$ref": "#/$defs/transformationCompositionWitness"},
        {"type": "null"}
      ],
      "default": null
    },
    "selected_episode_ids": {"$ref": "#/$defs/stringArray"},
    "exhaustion_witness": {
      "oneOf": [
        {"$ref": "#/$defs/exhaustionWitness"},
        {"type": "null"}
      ],
      "default": null
    },
    "missing_transformation_specification": {
      "oneOf": [
        {"$ref": "#/$defs/missingTransformationSpecification"},
        {"type": "null"}
      ],
      "default": null
    },
    "unresolved_warnings": {"$ref": "#/$defs/stringArray"},
    "evidence_pointers": {"$ref": "#/$defs/nonEmptyStringArray"},
    "artifact_hash": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "searchStatus": {
      "enum": ["MATCHES_FOUND", "NO_VIABLE_MATCH", "NOT_RUN"]
    },
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "obstructionFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obstruction_id",
        "domain",
        "roles",
        "relations",
        "constraints",
        "failure_mechanisms",
        "invariants_to_preserve",
        "desired_transition"
      ],
      "properties": {
        "obstruction_id": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "roles": {"$ref": "#/$defs/nonEmptyStringArray"},
        "relations": {"$ref": "#/$defs/nonEmptyStringArray"},
        "constraints": {"$ref": "#/$defs/nonEmptyStringArray"},
        "failure_mechanisms": {"$ref": "#/$defs/nonEmptyStringArray"},
        "invariants_to_preserve": {"$ref": "#/$defs/nonEmptyStringArray"},
        "desired_transition": {"$ref": "#/$defs/nonEmptyStringArray"},
        "forbidden_losses": {"$ref": "#/$defs/stringArray"}
      }
    },
    "structuralMappingWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "witness_id",
        "episode_id",
        "target_obstruction_id",
        "role_mapping",
        "shared_relations",
        "shared_constraints",
        "disanalogies",
        "target_validation_obligations",
        "evidence_pointers",
        "artifact_hash"
      ],
      "properties": {
        "witness_id": {"type": "string", "minLength": 1},
        "episode_id": {"type": "string", "minLength": 1},
        "target_obstruction_id": {"type": "string", "minLength": 1},
        "role_mapping": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "prefixItems": [
              {"type": "string", "minLength": 1},
              {"type": "string", "minLength": 1}
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "shared_relations": {"$ref": "#/$defs/nonEmptyStringArray"},
        "shared_constraints": {"$ref": "#/$defs/nonEmptyStringArray"},
        "disanalogies": {"$ref": "#/$defs/nonEmptyStringArray"},
        "target_validation_obligations": {"$ref": "#/$defs/nonEmptyStringArray"},
        "evidence_pointers": {"$ref": "#/$defs/nonEmptyStringArray"},
        "artifact_hash": {"type": "string", "minLength": 1}
      }
    },
    "transformationCompositionWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition_id",
        "target_obstruction_id",
        "episode_ids",
        "operation_order",
        "interface_obligations",
        "incompatibilities_checked",
        "target_validation_obligations",
        "evidence_pointers",
        "artifact_hash"
      ],
      "properties": {
        "composition_id": {"type": "string", "minLength": 1},
        "target_obstruction_id": {"type": "string", "minLength": 1},
        "episode_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "operation_order": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "interface_obligations": {"$ref": "#/$defs/nonEmptyStringArray"},
        "incompatibilities_checked": {"$ref": "#/$defs/nonEmptyStringArray"},
        "target_validation_obligations": {"$ref": "#/$defs/nonEmptyStringArray"},
        "evidence_pointers": {"$ref": "#/$defs/nonEmptyStringArray"},
        "artifact_hash": {"type": "string", "minLength": 1}
      }
    },
    "exhaustionWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_obstruction_id",
        "search_boundary",
        "searched_domains",
        "searched_method_families",
        "rejection_reasons",
        "residual_failure_ids",
        "repeated_residual_features",
        "evidence_pointers",
        "artifact_hash"
      ],
      "properties": {
        "target_obstruction_id": {"type": "string", "minLength": 1},
        "search_boundary": {"type": "string", "minLength": 1},
        "searched_domains": {"$ref": "#/$defs/nonEmptyStringArray"},
        "searched_method_families": {"$ref": "#/$defs/nonEmptyStringArray"},
        "rejected_direct_episode_ids": {"$ref": "#/$defs/stringArray"},
        "rejected_jump_episode_ids": {"$ref": "#/$defs/stringArray"},
        "rejected_glue_composition_ids": {"$ref": "#/$defs/stringArray"},
        "rejection_reasons": {"$ref": "#/$defs/nonEmptyStringArray"},
        "residual_failure_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "repeated_residual_features": {"$ref": "#/$defs/nonEmptyStringArray"},
        "evidence_pointers": {"$ref": "#/$defs/nonEmptyStringArray"},
        "artifact_hash": {"type": "string", "minLength": 1},
        "coverage_receipt_hash": {"type": "string", "default": ""}
      }
    },
    "missingTransformationSpecification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_id",
        "target_obstruction_id",
        "residual_failure_ids",
        "must_preserve",
        "must_break",
        "must_expose",
        "must_reduce",
        "allowed_representation_changes",
        "forbidden_shortcuts",
        "validation_obligations",
        "falsifiers",
        "evidence_pointers",
        "artifact_hash"
      ],
      "properties": {
        "spec_id": {"type": "string", "minLength": 1},
        "target_obstruction_id": {"type": "string", "minLength": 1},
        "residual_failure_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "must_preserve": {"$ref": "#/$defs/nonEmptyStringArray"},
        "must_break": {"$ref": "#/$defs/nonEmptyStringArray"},
        "must_expose": {"$ref": "#/$defs/nonEmptyStringArray"},
        "must_reduce": {"$ref": "#/$defs/nonEmptyStringArray"},
        "allowed_representation_changes": {"$ref": "#/$defs/nonEmptyStringArray"},
        "forbidden_shortcuts": {"$ref": "#/$defs/nonEmptyStringArray"},
        "validation_obligations": {"$ref": "#/$defs/nonEmptyStringArray"},
        "falsifiers": {"$ref": "#/$defs/nonEmptyStringArray"},
        "evidence_pointers": {"$ref": "#/$defs/nonEmptyStringArray"},
        "artifact_hash": {"type": "string", "minLength": 1}
      }
    }
  }
}
