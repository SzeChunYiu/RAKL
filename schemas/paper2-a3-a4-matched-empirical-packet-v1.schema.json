{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper2-a3-a4-matched-empirical-packet-v1.schema.json",
  "title": "Paper II matched A3 vs A4 empirical ablation packet v1",
  "description": "Frozen evaluation packet for issue #156 matched A3↔A4 empirics. Grants no scientific authority; inventing results is forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "issue",
    "arms",
    "intervention_pair",
    "evaluator_binding",
    "conformance_prerequisite",
    "matched_resource_contract",
    "frozen_metrics",
    "upstream_blockers",
    "execution_coordinates",
    "naming_rule",
    "grants_scientific_authority",
    "claim_boundary",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "paper2-a3-a4-matched-empirical-packet-v1"},
    "status": {
      "enum": [
        "PACKET_FROZEN_EMPIRICS_UNRUN",
        "EMPIRICS_BLOCKED",
        "SCORED_ARM_RESPONSES",
        "CANNOT_IDENTIFY",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "issue": {"const": 156},
    "arms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["arm_id", "role", "not_external_system"],
        "properties": {
          "arm_id": {
            "enum": [
              "A3_TRANSACTIONAL_GOVERNANCE_FUNCTION_MATCHED",
              "A4_SCIENTIFIC_AUTHORITY_TYPING"
            ]
          },
          "role": {"type": "string", "minLength": 1},
          "not_external_system": {"type": "string", "minLength": 1}
        }
      }
    },
    "intervention_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair", "minimal_difference", "falsifier"],
      "properties": {
        "pair": {"const": "A3 -> A4"},
        "minimal_difference": {"type": "string", "minLength": 1},
        "falsifier": {"type": "string", "minLength": 1}
      }
    },
    "evaluator_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "freeze_receipt_path",
        "panel_visible_sha256",
        "protocol_sha256",
        "panel_source_sha256",
        "scorer_source_sha256",
        "case_count"
      ],
      "properties": {
        "protocol_id": {"const": "scientific-transition-authority-v2"},
        "freeze_receipt_path": {
          "const": "benchmarks/scientific_transition_authority/FREEZE_RECEIPT_V2.json"
        },
        "panel_visible_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "panel_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scorer_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "case_count": {"const": 16}
      }
    },
    "conformance_prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_path", "required_status", "artifact_hash"],
      "properties": {
        "receipt_path": {
          "const": "research/paper2_closest_parent/A3_A4_CONFORMANCE_RECEIPT.json"
        },
        "required_status": {"const": "CONFORMANCE_PASS"},
        "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "matched_resource_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identical_visible_panel",
        "identical_case_order",
        "identical_tooling_budget_class",
        "report_benefit_and_cost"
      ],
      "properties": {
        "identical_visible_panel": {"const": true},
        "identical_case_order": {"const": true},
        "identical_tooling_budget_class": {"type": "string", "minLength": 1},
        "report_benefit_and_cost": {"const": true}
      }
    },
    "frozen_metrics": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "enum": [
          "alr",
          "valid_upgrade_recall",
          "false_conservative_refusal_rate",
          "wall_time_ms",
          "peak_rss_bytes",
          "state_growth_bytes",
          "terminal_status_accuracy"
        ]
      }
    },
    "upstream_blockers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "execution_coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_status",
        "pending_freeze_sentinels",
        "lunarc_authorized",
        "results_invented"
      ],
      "properties": {
        "protocol_status": {"type": "string", "minLength": 1},
        "pending_freeze_sentinels": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^PENDING_FREEZE_"}
        },
        "lunarc_authorized": {"type": "boolean"},
        "results_invented": {"const": false}
      }
    },
    "naming_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arms_may_not_be_named_as_external_systems", "forbidden_labels"],
      "properties": {
        "arms_may_not_be_named_as_external_systems": {"const": true},
        "forbidden_labels": {
          "type": "array",
          "minItems": 3,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "grants_scientific_authority": {"const": false},
    "claim_boundary": {"type": "string", "minLength": 1},
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
