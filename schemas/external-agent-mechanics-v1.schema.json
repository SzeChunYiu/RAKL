{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/external-agent-mechanics-v1.schema.json",
  "title": "External Competitor Mechanic Records",
  "description": "Competitor process mechanics compiled into the RAKL mechanism vocabulary (issue #588 Phase 1). A record here is a transfer obligation, not a validated improvement, and carries no scientific or promotion authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "freeze_date",
    "grants_scientific_authority",
    "grants_promotion_authority",
    "mechanics"
  ],
  "properties": {
    "schema_version": {"const": "external-agent-mechanics-v1"},
    "freeze_date": {"type": "string", "format": "date"},
    "grants_scientific_authority": {"const": false},
    "grants_promotion_authority": {"const": false},
    "note": {"type": "string"},
    "mechanics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mechanic_id",
          "source_system_ids",
          "process_surface",
          "preconditions",
          "mechanism",
          "claimed_benefit",
          "cost",
          "failure_modes",
          "scope",
          "independent_evidence",
          "rakl_analogue",
          "candidate_transfer_obligation"
        ],
        "properties": {
          "mechanic_id": {"type": "string", "pattern": "^MEC-[A-Z0-9_]+$"},
          "source_system_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SYS-[A-Z0-9_]+$"}},
          "process_surface": {"type": "string", "minLength": 1},
          "preconditions": {"type": "string", "minLength": 1},
          "mechanism": {"type": "string", "minLength": 1},
          "claimed_benefit": {
            "description": "What the source claims. Recording a claim is not endorsing it; independent_evidence is the field that says whether anyone checked.",
            "type": "string",
            "minLength": 1
          },
          "cost": {"type": "string", "minLength": 1},
          "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "scope": {"type": "string", "minLength": 1},
          "independent_evidence": {
            "description": "Must begin with NONE until a reproduction has actually been run, so a competitor's self-report can never be laundered into independent support.",
            "type": "string",
            "minLength": 1
          },
          "rakl_analogue": {"type": "string", "minLength": 1},
          "candidate_transfer_obligation": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
