{
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper2-cpu-staging-harvest-receipt-v3-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "contract_canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "evaluated_result_record_count": {
      "const": 0
    },
    "expected_repo_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "job_ids": {
      "items": {
        "pattern": "^[0-9]+$",
        "type": "string"
      },
      "maxItems": 2,
      "type": "array"
    },
    "model_execution_performed": {
      "const": false
    },
    "schema_version": {
      "const": "paper2-cpu-staging-harvest-receipt-v3.1"
    },
    "verdict": {
      "enum": [
        "HARVEST_STAGING_PASS",
        "HARVEST_STAGING_NEGATIVE_PRESERVED",
        "HARVEST_CANNOT_CHECK"
      ]
    }
  },
  "required": [
    "schema_version",
    "created_at_utc",
    "contract_canonical_sha256",
    "expected_repo_sha",
    "job_ids",
    "model_execution_performed",
    "evaluated_result_record_count",
    "verdict"
  ],
  "title": "Paper 2 CPU staging V3.1 harvest receipt",
  "type": "object"
}
