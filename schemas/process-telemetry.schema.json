{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakl.invalid/schemas/process-telemetry.schema.json",
  "title": "RAKL process telemetry",
  "description": "Proposal-only measurement record for one canonical RAKL method-surface invocation. Validation grants no scientific or authority promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invocation_id",
    "process_surface",
    "task_id",
    "episode_id",
    "input_state_hash",
    "output_state_hash",
    "input_fibre_hash",
    "output_hash",
    "outcome",
    "cost",
    "residual_before",
    "residual_after",
    "retained_novelty",
    "retrieved_ids",
    "selected_ids",
    "rejected_ids",
    "verification_ids",
    "evidence_pointers",
    "timestamp",
    "authority_scope"
  ],
  "properties": {
    "invocation_id": {"type": "string", "minLength": 1},
    "process_surface": {
      "enum": [
        "decomposition",
        "routing",
        "search_query_generation",
        "source_selection_reliability",
        "claim_extraction",
        "ontology_terminology_normalization",
        "mathematical_context_translation",
        "equivalence_similarity",
        "contextual_theory_gluing",
        "contradiction_diagnosis",
        "gap_discovery",
        "experiment_query_selection",
        "synthesis",
        "memory",
        "review",
        "benchmarking",
        "authority_promotion",
        "saturation_stopping",
        "prompting_context_policy",
        "capability_shaping",
        "software_architecture_execution",
        "research_portfolio_tree",
        "objective_evolution",
        "generator_transport"
      ]
    },
    "task_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string"},
    "input_state_hash": {"type": "string", "minLength": 1},
    "output_state_hash": {"type": "string", "minLength": 1},
    "input_fibre_hash": {"type": "string"},
    "output_hash": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["SUCCESS", "PARTIAL_SUCCESS", "FAILURE", "BLOCKED", "CANNOT_CHECK"]},
    "cost": {"type": "number", "minimum": 0},
    "residual_before": {"type": "array", "items": {"type": "string"}},
    "residual_after": {"type": "array", "items": {"type": "string"}},
    "retained_novelty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "KNOWLEDGE": {"type": "integer", "minimum": 0},
        "OPERATOR": {"type": "integer", "minimum": 0},
        "EXPERIENCE_PATTERN": {"type": "integer", "minimum": 0},
        "OBSTRUCTION": {"type": "integer", "minimum": 0},
        "RELATION": {"type": "integer", "minimum": 0},
        "PATH": {"type": "integer", "minimum": 0},
        "META_METHOD": {"type": "integer", "minimum": 0}
      }
    },
    "retrieved_ids": {"type": "array", "items": {"type": "string"}},
    "selected_ids": {"type": "array", "items": {"type": "string"}},
    "rejected_ids": {"type": "array", "items": {"type": "string"}},
    "verification_ids": {"type": "array", "items": {"type": "string"}},
    "evidence_pointers": {"type": "array", "items": {"type": "string"}},
    "timestamp": {"type": "string", "format": "date-time"},
    "authority_scope": {"const": "MEASUREMENT_ONLY"}
  }
}