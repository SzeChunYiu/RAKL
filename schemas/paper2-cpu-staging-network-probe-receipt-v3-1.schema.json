{
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper2-cpu-staging-network-probe-receipt-v3-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "contract_canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "expected_repo_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "failures": {
      "type": "array"
    },
    "model_execution_performed": {
      "const": false
    },
    "observations": {
      "type": "array"
    },
    "schema_version": {
      "const": "paper2-cpu-staging-network-probe-receipt-v3.1"
    },
    "verdict": {
      "enum": [
        "NETWORK_PROBE_PASS",
        "NETWORK_PROBE_FAIL"
      ]
    }
  },
  "required": [
    "schema_version",
    "created_at_utc",
    "contract_canonical_sha256",
    "expected_repo_sha",
    "model_execution_performed",
    "observations",
    "failures",
    "verdict"
  ],
  "title": "Paper 2 CPU staging V3.1 network probe receipt",
  "type": "object"
}
