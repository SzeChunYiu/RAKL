{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/episode-admission-receipt.schema.json",
  "title": "RAKL Episode Admission Receipt",
  "description": "Protected registration/admission receipt binding an exact TaskEpisode identity for canonical inventory membership. Path/name heuristics and shadow-only storage never mint this authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "episode_id",
    "episode_artifact_hash",
    "storage_admission",
    "evidence_pointers",
    "artifact_hash",
    "timestamp"
  ],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "episode_artifact_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "storage_admission": {"const": "CANONICAL_INVENTORY_ADMITTED"},
    "evidence_pointers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "artifact_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
