{
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper2-native-v3-1-failure-v3-2-repair-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "chronology": {
      "maxItems": 7,
      "minItems": 7,
      "type": "array"
    },
    "created_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "cumulative_native_staging_counts": {
      "const": {
        "evaluated_result_records": 0,
        "jobs_submitted": 4,
        "model_executions": 0
      }
    },
    "execution_counts_this_retry": {
      "const": {
        "evaluated_result_records": 0,
        "jobs_submitted": 2,
        "model_executions": 0
      }
    },
    "manuscript_status": {
      "properties": {
        "quantitative_figure_generated": {
          "const": false
        }
      },
      "required": [
        "quantitative_figure_generated"
      ],
      "type": "object"
    },
    "native_receipts_and_raw_evidence": {
      "maxItems": 10,
      "minItems": 10,
      "type": "array"
    },
    "schema_binding": {
      "properties": {
        "path": {
          "const": "schemas/paper2-native-v3-1-failure-v3-2-repair-receipt.schema.json"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "paper2-native-v3-1-failure-v3-2-repair-receipt-v1"
    },
    "subject_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "v3_2_repair": {
      "properties": {
        "native_result_available": {
          "const": false
        },
        "native_submission_performed": {
          "const": false
        },
        "operator_state": {
          "const": "REPAIR_READY_NOT_SUBMITTED"
        }
      },
      "required": [
        "native_submission_performed",
        "native_result_available",
        "operator_state"
      ],
      "type": "object"
    },
    "verdict": {
      "const": "NATIVE_V3_1_STAGING_FAILURE_PRESERVED__V3_2_REPAIR_READY_NOT_SUBMITTED"
    }
  },
  "required": [
    "schema_version",
    "created_at_utc",
    "subject_sha",
    "chronology",
    "native_receipts_and_raw_evidence",
    "execution_counts_this_retry",
    "cumulative_native_staging_counts",
    "v3_2_repair",
    "manuscript_status",
    "schema_binding",
    "verdict"
  ],
  "title": "Paper 2 native V3.1 failure and V3.2 repair receipt",
  "type": "object"
}
