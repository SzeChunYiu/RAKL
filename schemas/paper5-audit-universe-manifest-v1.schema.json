{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper5-audit-universe-manifest-v1.schema.json",
  "title": "Paper 5 retained-novelty audit universe manifest",
  "description": "Phase 0 freeze binding the #255 audit universe to the frozen #253 longitudinal dataset. Does not authorize construct-validity claims or external annotation authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_epoch_id",
    "audit_id",
    "issue",
    "depends_on_issue",
    "status",
    "frozen_at_utc",
    "cutoff_timestamp_utc",
    "framework_repository",
    "source_repository",
    "protocol_path",
    "longitudinal_dataset_manifest_path",
    "measurement_basis_path",
    "retained_growth_events_source_path",
    "freeze_version",
    "framework_measurement_basis_sha256",
    "dataset_manifest_sha256",
    "retained_event_universe_path",
    "retained_event_universe_sha256",
    "control_event_universe_path",
    "control_event_universe_sha256",
    "blinded_audit_candidate_frame_path",
    "blinded_audit_candidate_frame_sha256",
    "internal_stratification_path",
    "internal_stratification_sha256",
    "zero_external_novelty_labels_path",
    "zero_external_novelty_labels_sha256",
    "event_counts",
    "grants_scientific_authority",
    "claim_boundary",
    "next_phase_blockers"
  ],
  "properties": {
    "schema_version": {"const": "paper5-audit-universe-manifest-v1"},
    "audit_epoch_id": {"type": "string", "minLength": 1},
    "audit_id": {"type": "string", "minLength": 1},
    "issue": {"const": 255},
    "depends_on_issue": {"const": 253},
    "status": {"const": "AUDIT_UNIVERSE_FROZEN_PHASE0"},
    "frozen_at_utc": {"type": "string", "minLength": 1},
    "cutoff_timestamp_utc": {"type": "string", "minLength": 1},
    "framework_repository": {"const": "SzeChunYiu/RAKL"},
    "source_repository": {"const": "SzeChunYiu/RAKL_math"},
    "protocol_path": {"type": "string", "minLength": 1},
    "longitudinal_dataset_manifest_path": {"type": "string", "minLength": 1},
    "measurement_basis_path": {"type": "string", "minLength": 1},
    "retained_growth_events_source_path": {"type": "string", "minLength": 1},
    "freeze_version": {"type": "string", "minLength": 1},
    "framework_measurement_basis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "retained_event_universe_path": {"type": "string", "minLength": 1},
    "retained_event_universe_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "control_event_universe_path": {"type": "string", "minLength": 1},
    "control_event_universe_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "blinded_audit_candidate_frame_path": {"type": "string", "minLength": 1},
    "blinded_audit_candidate_frame_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "internal_stratification_path": {"type": "string", "minLength": 1},
    "internal_stratification_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "zero_external_novelty_labels_path": {"type": "string", "minLength": 1},
    "zero_external_novelty_labels_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_counts": {"type": "object"},
    "grants_scientific_authority": {"const": false},
    "claim_boundary": {"type": "string", "minLength": 1},
    "next_phase_blockers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
