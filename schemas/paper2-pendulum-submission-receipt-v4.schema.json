{
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper2-pendulum-submission-receipt-v4.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batch_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "claim_boundary": {
      "minLength": 1,
      "type": "string"
    },
    "created_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "evaluated_result_record_count_observed_by_submitter": {
      "const": 0
    },
    "expected_repo_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "model_execution_observed_by_submitter": {
      "const": false
    },
    "packet_parent_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "schema_version": {
      "const": "paper2-pendulum-submission-receipt-v4"
    },
    "slurm_job_id": {
      "pattern": "^[0-9]+$",
      "type": "string"
    },
    "verdict": {
      "const": "SUBMITTED_NONCONFIRMATORY_TASK_SEED_BATCH"
    }
  },
  "required": [
    "schema_version",
    "created_at_utc",
    "verdict",
    "expected_repo_sha",
    "packet_parent_sha",
    "batch_contract_sha256",
    "slurm_job_id",
    "model_execution_observed_by_submitter",
    "evaluated_result_record_count_observed_by_submitter",
    "claim_boundary"
  ],
  "type": "object"
}
