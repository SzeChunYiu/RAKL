{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/math-context-fiber.schema.json",
  "title": "RAKL Mathematical Context Fiber",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "atom_id",
    "object_context",
    "structural_coordinates",
    "equivalent_formulations",
    "method_transfers",
    "explicit_disanalogies",
    "source_anchors",
    "analogy_scan_status",
    "frozen_at",
    "packet_hash"
  ],
  "properties": {
    "atom_id": {"type": "string", "minLength": 1},
    "object_context": {"type": "string", "minLength": 1},
    "structural_coordinates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "equivalent_formulations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "solved_analogues": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
    "near_solved_analogues": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
    "method_transfers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_context", "method", "shared_structure", "required_assumptions", "disanalogies", "repair_question", "source_anchors"],
        "properties": {
          "source_context": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "shared_structure": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "required_assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "disanalogies": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "repair_question": {"type": "string", "minLength": 1},
          "source_anchors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "explicit_disanalogies": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_anchors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "analogy_scan_status": {"enum": ["BRIDGES_RETAINED", "NO_SAFE_BRIDGE_FOUND"]},
    "cross_domain_analogies": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_kind", "source_situation", "common_abstraction", "source_to_target_mapping", "shared_constraints", "disanalogies", "proposed_principle", "validation_obligation", "provenance_note"],
        "properties": {
          "source_kind": {"type": "string", "minLength": 1},
          "source_situation": {"type": "string", "minLength": 1},
          "common_abstraction": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "source_to_target_mapping": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "shared_constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "disanalogies": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "proposed_principle": {"type": "string", "minLength": 1},
          "validation_obligation": {"type": "string", "minLength": 1},
          "provenance_note": {"type": "string", "minLength": 1}
        }
      }
    },
    "analogy_scan_notes": {"type": "string", "default": ""},
    "frozen_at": {"type": "string", "format": "date-time"},
    "first_candidate_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "packet_hash": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "anyOf": [
        {"required": ["solved_analogues"], "properties": {"solved_analogues": {"minItems": 1}}},
        {"required": ["near_solved_analogues"], "properties": {"near_solved_analogues": {"minItems": 1}}}
      ]
    },
    {
      "if": {"properties": {"analogy_scan_status": {"const": "BRIDGES_RETAINED"}}},
      "then": {"required": ["cross_domain_analogies"], "properties": {"cross_domain_analogies": {"minItems": 1}}},
      "else": {"required": ["analogy_scan_notes"], "properties": {"analogy_scan_notes": {"minLength": 1}}}
    }
  ]
}
