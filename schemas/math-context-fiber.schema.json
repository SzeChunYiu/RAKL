{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/math-context-fiber.schema.json",
  "title": "RAKL Mathematical Context Fiber",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "atom_id",
    "object_context",
    "structural_coordinates",
    "equivalent_formulations",
    "method_transfers",
    "explicit_disanalogies",
    "source_anchors",
    "frozen_at",
    "packet_hash"
  ],
  "properties": {
    "atom_id": {"type": "string", "minLength": 1},
    "object_context": {"type": "string", "minLength": 1},
    "structural_coordinates": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "equivalent_formulations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "solved_analogues": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "near_solved_analogues": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "method_transfers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_context",
          "method",
          "shared_structure",
          "required_assumptions",
          "disanalogies",
          "repair_question",
          "source_anchors"
        ],
        "properties": {
          "source_context": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "shared_structure": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "required_assumptions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "disanalogies": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "repair_question": {"type": "string", "minLength": 1},
          "source_anchors": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "explicit_disanalogies": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "source_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "frozen_at": {"type": "string", "format": "date-time"},
    "first_candidate_at": {
      "anyOf": [
        {"type": "string", "format": "date-time"},
        {"type": "null"}
      ]
    },
    "packet_hash": {"type": "string", "minLength": 1}
  },
  "anyOf": [
    {"required": ["solved_analogues"], "properties": {"solved_analogues": {"minItems": 1}}},
    {"required": ["near_solved_analogues"], "properties": {"near_solved_analogues": {"minItems": 1}}}
  ]
}
