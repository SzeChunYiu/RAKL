{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/mechanic-research-packet.schema.json",
  "title": "Mechanic Research Packet",
  "description": "Proposal-only preregistration packet required before an Orion mechanic variant is eligible for the existing promotion gate. This schema grants no scientific or promotion authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "mechanic_id",
    "variant_id",
    "parent_method_sha",
    "object_description",
    "qoi",
    "scope",
    "assumptions",
    "strongest_parents",
    "prior_art_equivalence_map",
    "oracle_or_lower_bound",
    "minimal_counterexamples",
    "development_benchmark_id",
    "development_case_ids",
    "fresh_assurance_benchmark_id",
    "fresh_assurance_case_ids",
    "selection_case_ids",
    "falsifier",
    "same_system_ablation",
    "hard_gate_obligations",
    "required_telemetry_fields",
    "total_cost_equation",
    "novelty_residual",
    "permitted_publication_claim",
    "evidence_pointers",
    "mechanism_gate_state",
    "applicability_gate_state",
    "frozen_before_implementation",
    "frozen_before_outcome_access",
    "packet_content_sha256",
    "grants_scientific_authority",
    "grants_promotion_authority",
    "replaces_promotion_gate"
  ],
  "properties": {
    "schema_version": {"const": "mechanic-research-packet-v1"},
    "packet_id": {"type": "string", "minLength": 1},
    "mechanic_id": {"type": "string", "minLength": 1},
    "variant_id": {"type": "string", "minLength": 1},
    "parent_method_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "object_description": {"type": "string", "minLength": 1},
    "qoi": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "strongest_parents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parent_id", "implementation_refs", "cost_model_id", "cost_equation", "justification", "evidence_pointers"],
        "properties": {
          "parent_id": {"type": "string", "minLength": 1},
          "implementation_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "cost_model_id": {"type": "string", "minLength": 1},
          "cost_equation": {"type": "string", "minLength": 1},
          "justification": {"type": "string", "minLength": 1},
          "evidence_pointers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "prior_art_equivalence_map": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "oracle_or_lower_bound": {"type": "string", "minLength": 1},
    "minimal_counterexamples": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "development_benchmark_id": {"type": "string", "minLength": 1},
    "development_case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "fresh_assurance_benchmark_id": {"type": "string", "minLength": 1},
    "fresh_assurance_case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "selection_case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "falsifier": {"type": "string", "minLength": 1},
    "same_system_ablation": {"type": "string", "minLength": 1},
    "hard_gate_obligations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_telemetry_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "total_cost_equation": {"type": "string", "minLength": 1},
    "novelty_residual": {"type": "string", "minLength": 1},
    "permitted_publication_claim": {"type": "string", "minLength": 1},
    "evidence_pointers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "mechanism_gate_state": {"const": "UNASSESSED"},
    "applicability_gate_state": {"const": "UNASSESSED"},
    "frozen_before_implementation": {"const": true},
    "frozen_before_outcome_access": {"const": true},
    "packet_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "grants_scientific_authority": {"const": false},
    "grants_promotion_authority": {"const": false},
    "replaces_promotion_gate": {"const": false}
  }
}
