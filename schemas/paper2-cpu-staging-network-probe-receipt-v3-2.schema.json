{
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper2-cpu-staging-network-probe-receipt-v3-2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "NETWORK_PROBE_PASS"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "failures": {
            "maxItems": 0
          },
          "observations": {
            "maxItems": 38,
            "minItems": 38
          },
          "observed_repo_sha": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "slurm_job_id": {
            "pattern": "^[0-9]+$",
            "type": "string"
          }
        }
      }
    }
  ],
  "properties": {
    "contract_canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "evaluated_result_record_count": {
      "const": 0
    },
    "expected_repo_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "failures": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "model_execution_performed": {
      "const": false
    },
    "observations": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "artifact_id": {
            "minLength": 1,
            "type": "string"
          },
          "http_status": {
            "maximum": 599,
            "minimum": 100,
            "type": [
              "integer",
              "null"
            ]
          },
          "reachable": {
            "type": "boolean"
          }
        },
        "required": [
          "artifact_id",
          "http_status",
          "reachable"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "observed_repo_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "paper2-cpu-staging-network-probe-receipt-v3.2"
    },
    "slurm_job_id": {
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "verdict": {
      "enum": [
        "NETWORK_PROBE_PASS",
        "NETWORK_PROBE_FAIL"
      ]
    }
  },
  "required": [
    "schema_version",
    "created_at_utc",
    "contract_canonical_sha256",
    "expected_repo_sha",
    "observed_repo_sha",
    "slurm_job_id",
    "observations",
    "failures",
    "model_execution_performed",
    "evaluated_result_record_count",
    "verdict"
  ],
  "title": "Paper 2 CPU staging V3.2 network probe receipt",
  "type": "object"
}
