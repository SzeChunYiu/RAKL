{
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper2-native-v3-2-success-harvest-repair-internal-review.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blocking_concerns": {
      "maxItems": 0,
      "type": "array"
    },
    "checks": {
      "additionalProperties": false,
      "properties": {
        "cumulative_counts_source_derived": {
          "const": true
        },
        "evaluated_result_record_count": {
          "const": 0
        },
        "focused_tests": {
          "const": {
            "failed": 0,
            "passed": 14
          }
        },
        "job_submission_performed_by_repair": {
          "const": false
        },
        "model_execution_performed": {
          "const": false
        },
        "native_bundle_members_byte_equal": {
          "const": true
        },
        "native_sacct_semantics_derived": {
          "const": true
        },
        "quantitative_figure_generated": {
          "const": false
        },
        "schema_valid_cannot_check_world": {
          "const": true
        }
      },
      "required": [
        "focused_tests",
        "native_sacct_semantics_derived",
        "native_bundle_members_byte_equal",
        "cumulative_counts_source_derived",
        "schema_valid_cannot_check_world",
        "job_submission_performed_by_repair",
        "model_execution_performed",
        "evaluated_result_record_count",
        "quantitative_figure_generated"
      ],
      "type": "object"
    },
    "claim_boundary": {
      "minLength": 1,
      "type": "string"
    },
    "concern_ledger": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "concern_id": {
            "pattern": "^P2-V321-HR-B[0-9]{2}$",
            "type": "string"
          },
          "finding": {
            "minLength": 1,
            "type": "string"
          },
          "resolution": {
            "minLength": 1,
            "type": "string"
          },
          "severity": {
            "const": "blocking"
          },
          "state": {
            "const": "closed"
          }
        },
        "required": [
          "concern_id",
          "severity",
          "finding",
          "resolution",
          "state"
        ],
        "type": "object"
      },
      "maxItems": 8,
      "minItems": 8,
      "type": "array"
    },
    "created_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "nonblocking_concerns": {
      "type": "array"
    },
    "object": {
      "minLength": 1,
      "type": "string"
    },
    "passes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "concerns": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "pass_id": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "BLOCKED",
              "PASS"
            ]
          }
        },
        "required": [
          "pass_id",
          "verdict",
          "concerns"
        ],
        "type": "object"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "review_class": {
      "const": "internal_recursive_hostile_review_not_independent_not_peer_review"
    },
    "review_id": {
      "const": "paper2-native-v3-2-success-harvest-repair-internal-review-20260811"
    },
    "reviewed_artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "role",
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 15,
      "type": "array"
    },
    "schema_binding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "schemas/paper2-native-v3-2-success-harvest-repair-internal-review.schema.json"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "paper2-native-v3-2-success-harvest-repair-internal-review-v1"
    },
    "verdict": {
      "const": "PASS__HARVEST_REPAIR_READY_NOT_REHARVESTED"
    }
  },
  "required": [
    "schema_version",
    "created_at_utc",
    "review_id",
    "object",
    "claim_boundary",
    "review_class",
    "schema_binding",
    "reviewed_artifacts",
    "passes",
    "concern_ledger",
    "blocking_concerns",
    "nonblocking_concerns",
    "checks",
    "verdict"
  ],
  "title": "Paper 2 V3.2 native success and V3.2.1 repair internal review",
  "type": "object"
}
