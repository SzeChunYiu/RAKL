{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/backup_manifest.schema.json",
  "title": "ORION BackupManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_snapshot_id",
    "created_at_utc",
    "entries",
    "backup_id"
  ],
  "properties": {
    "project_snapshot_id": {
      "type": "string",
      "pattern": "^snapshot:[0-9a-f]{64}$"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logical_path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "logical_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "backup_id": {
      "type": "string",
      "pattern": "^backup:[0-9a-f]{64}$"
    }
  }
}
