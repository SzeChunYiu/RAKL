{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper3-empirical-result.schema.json",
  "title": "RAKL Paper 3 empirical result receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "subject_sha",
    "created_at_utc",
    "frozen_protocol_id",
    "records"
  ],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "subject_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "frozen_protocol_id": {"type": "string", "minLength": 1},
    "provider_price_sheet_id": {"type": ["string", "null"]},
    "notes": {"type": "string"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/run"}
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "seed",
        "arm",
        "base_model_id",
        "structure_family",
        "source_domain",
        "target_domain",
        "quadrant",
        "transfer_valid",
        "transfer_accepted",
        "task_correct",
        "valid_success",
        "inference_input_tokens",
        "inference_output_tokens",
        "verification_tokens",
        "tool_calls",
        "retrieval_calls",
        "wall_time_ms"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "arm": {"type": "string", "minLength": 1},
        "base_model_id": {"type": "string", "minLength": 1},
        "tokenizer_id": {"type": ["string", "null"]},
        "structure_family": {"type": "string", "minLength": 1},
        "source_domain": {"type": "string", "minLength": 1},
        "target_domain": {"type": "string", "minLength": 1},
        "quadrant": {"enum": ["Q1", "Q2", "Q3", "Q4"]},
        "semantic_score": {"type": ["number", "null"]},
        "structural_score": {"type": ["number", "null"]},
        "transfer_valid": {"type": "boolean"},
        "transfer_accepted": {"type": "boolean"},
        "task_correct": {"type": "boolean"},
        "valid_success": {"type": "boolean"},
        "training_tokens_cumulative": {"type": ["integer", "null"], "minimum": 0},
        "training_examples_cumulative": {"type": ["integer", "null"], "minimum": 0},
        "training_compute_seconds": {"type": ["number", "null"], "minimum": 0},
        "training_capability_score": {"type": ["number", "null"]},
        "inference_input_tokens": {"type": "integer", "minimum": 0},
        "inference_output_tokens": {"type": "integer", "minimum": 0},
        "verification_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "retrieval_calls": {"type": "integer", "minimum": 0},
        "retrieved_bytes": {"type": ["integer", "null"], "minimum": 0},
        "search_nodes": {"type": ["integer", "null"], "minimum": 0},
        "wall_time_ms": {"type": "integer", "minimum": 0},
        "provider_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "induction_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "storage_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "structural_object_id": {"type": ["string", "null"]},
        "structural_object_cache_hit": {"type": ["boolean", "null"]},
        "reuse_index": {"type": ["integer", "null"], "minimum": 0},
        "failure_reason": {"type": ["string", "null"]}
      }
    }
  }
}
