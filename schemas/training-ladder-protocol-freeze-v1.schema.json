{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/training-ladder-protocol-freeze-v1.schema.json",
  "title": "RAKL training ladder Phase 0/1 protocol freeze",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "protocol_version",
    "issue",
    "parent_issue",
    "repo_sha",
    "rakl_version",
    "packet_frozen_at",
    "frozen_before_outcomes",
    "frozen_before_learner_runs",
    "grants_scientific_authority",
    "scientific_claim_status",
    "evaluated_results_accessed",
    "learner_outcomes_accessed",
    "phase",
    "structural_families",
    "generator",
    "hostile_controls",
    "exposure_curve_harness",
    "allowed_terminals",
    "forbidden_claims",
    "authority_boundary",
    "runs",
    "protocol_subject_hash"
  ],
  "properties": {
    "schema_version": { "const": "rakl-training-ladder-protocol-freeze-v1" },
    "benchmark_id": { "type": "string" },
    "protocol_version": { "type": "string" },
    "issue": { "const": 461 },
    "parent_issue": { "const": 455 },
    "repo_sha": { "type": "string", "minLength": 40 },
    "rakl_version": { "type": "string" },
    "packet_frozen_at": { "type": "string" },
    "frozen_before_outcomes": { "const": true },
    "frozen_before_learner_runs": { "const": true },
    "grants_scientific_authority": { "const": false },
    "scientific_claim_status": { "const": "NO_EMPIRICAL_RESULT" },
    "evaluated_results_accessed": { "const": false },
    "learner_outcomes_accessed": { "const": false },
    "phase": { "const": "0/1" },
    "blocked_successors": { "type": "object" },
    "structural_families": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string" }
    },
    "generator": { "type": "object" },
    "hostile_controls": { "type": "object" },
    "exposure_curve_harness": { "type": "object" },
    "allowed_terminals": { "type": "array", "minItems": 1 },
    "forbidden_claims": { "type": "array", "minItems": 1 },
    "authority_boundary": { "type": "string" },
    "runs": { "type": "array", "maxItems": 0 },
    "protocol_subject_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
