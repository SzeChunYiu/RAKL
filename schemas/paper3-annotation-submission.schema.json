{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper3-annotation-submission.schema.json",
  "title": "Paper 3 independent annotation submission v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "packet_sha256", "protocol_id", "protocol_sha256", "rubric_id", "rubric_sha256", "annotator_id", "attestation", "items"],
  "properties": {
    "schema_version": {"const": "paper3-external-annotation-submission-v2"},
    "packet_id": {"type": "string", "minLength": 1},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_id": {"const": "paper3-confirmatory-gate-v2"},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rubric_id": {"type": "string", "minLength": 1},
    "rubric_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "annotator_id": {"type": "string", "minLength": 1},
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_or_domain_expert", "independent_of_benchmark_author", "no_other_annotator_or_result_access", "conflicts_disclosed", "completed_at_utc"],
      "properties": {
        "human_or_domain_expert": {"const": true},
        "independent_of_benchmark_author": {"const": true},
        "no_other_annotator_or_result_access": {"const": true},
        "conflicts_disclosed": {"const": true},
        "completed_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
      }
    },
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/judgement"}}
  },
  "$defs": {
    "judgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "semantic_similarity_high", "structural_match", "roles_preserved", "typed_relations_preserved", "invariant_preserved", "boundary_matched", "qoi_matched", "directional_mapping_complete", "transfer_valid", "cannot_assess", "rationale", "evidence_refs"],
      "properties": {
        "item_id": {"type": "string", "pattern": "^p3item-[0-9a-f]{20}$"},
        "semantic_similarity_high": {"type": "boolean"},
        "structural_match": {"type": "boolean"},
        "roles_preserved": {"type": "boolean"},
        "typed_relations_preserved": {"type": "boolean"},
        "invariant_preserved": {"type": "boolean"},
        "boundary_matched": {"type": "boolean"},
        "qoi_matched": {"type": "boolean"},
        "directional_mapping_complete": {"type": "boolean"},
        "transfer_valid": {"type": "boolean"},
        "cannot_assess": {"const": false},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
