{
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper2-cpu-staging-harvest-receipt-v3-2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "HARVEST_STAGING_PASS"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "failure_receipt_sha256": {
            "type": "null"
          },
          "failures": {
            "maxItems": 0
          },
          "job_ids": {
            "maxItems": 2,
            "minItems": 2
          },
          "negative_history_preserved": {
            "const": false
          },
          "probe_receipt_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "scheduler_rows": {
            "maxItems": 2,
            "minItems": 2
          },
          "staging_receipt_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "HARVEST_STAGING_NEGATIVE_PRESERVED"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "failure_receipt_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "failures": {
            "minItems": 1
          },
          "job_ids": {
            "maxItems": 2,
            "minItems": 2
          },
          "negative_history_preserved": {
            "const": true
          },
          "probe_receipt_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "scheduler_rows": {
            "maxItems": 2,
            "minItems": 2
          },
          "staging_receipt_sha256": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "bootstrap_receipt_path": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "bootstrap_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "contract_canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "evaluated_result_record_count": {
      "const": 0
    },
    "expected_repo_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "failure_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "failures": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "job_ids": {
      "items": {
        "pattern": "^[0-9]+$",
        "type": "string"
      },
      "maxItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "model_execution_performed": {
      "const": false
    },
    "negative_history_preserved": {
      "type": "boolean"
    },
    "probe_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "scheduler_rows": {
      "items": {
        "required": [
          "job_id",
          "state",
          "exit_code",
          "elapsed",
          "max_rss",
          "node_list"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "paper2-cpu-staging-harvest-receipt-v3.2"
    },
    "staging_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "submission_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "HARVEST_STAGING_PASS",
        "HARVEST_STAGING_NEGATIVE_PRESERVED",
        "HARVEST_CANNOT_CHECK"
      ]
    }
  },
  "required": [
    "schema_version",
    "created_at_utc",
    "submission_receipt_sha256",
    "contract_canonical_sha256",
    "expected_repo_sha",
    "job_ids",
    "scheduler_rows",
    "probe_receipt_sha256",
    "staging_receipt_sha256",
    "failure_receipt_sha256",
    "failures",
    "negative_history_preserved",
    "model_execution_performed",
    "evaluated_result_record_count",
    "verdict"
  ],
  "title": "Paper 2 CPU staging V3.2 harvest receipt",
  "type": "object"
}
