{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/current-work-coverage-v1.schema.json",
  "title": "RAKL current work-state coverage receipt v1",
  "description": "Proposal-only, framework-process evidence binding the open issue/PR universe a consequential route actually searched before route selection. Promotes no application evidence, mathematical, novelty, tool, review-independence, or promotion authority. Full PR diff enumeration is deliberately not required: a hashed index plus targeted retrieval is sufficient when coverage_semantics states so explicitly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "observed_default_branch",
    "observed_default_branch_head",
    "search_surface",
    "open_work_index_hash",
    "coverage_semantics",
    "bound_open_work_universe",
    "work_item_records",
    "route_id",
    "public_trace_event_id",
    "claim_boundary",
    "evidence_pointers",
    "receipt_canonical_sha256",
    "grants_application_evidence_authority",
    "grants_mathematical_authority",
    "grants_novelty_authority",
    "grants_tool_authority",
    "grants_review_independence_authority",
    "grants_promotion_authority",
    "requires_full_pr_diff_enumeration"
  ],
  "properties": {
    "schema_version": {"const": "current-work-coverage-v1"},
    "repository": {"type": "string", "minLength": 1, "maxLength": 512},
    "observed_default_branch": {"type": "string", "minLength": 1, "maxLength": 256},
    "observed_default_branch_head": {
      "description": "Exact default-branch head SHA observed when the open-work universe was bound.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[0-9A-Za-z._:+/-]+$"
    },
    "search_surface": {
      "description": "Exact query/search surface used for issues and pull requests.",
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "open_work_index_hash": {
      "description": "Authenticated index hash when coverage_semantics is HASHED_INDEX_TARGETED_RETRIEVAL.",
      "type": "string",
      "maxLength": 256
    },
    "coverage_semantics": {
      "enum": [
        "FULL_ARTIFACT_ENUMERATION",
        "HASHED_INDEX_TARGETED_RETRIEVAL",
        "SAMPLED_SUBSET",
        "UNSPECIFIED"
      ]
    },
    "bound_open_work_universe": {
      "description": "Open issue/PR ids this receipt binds. An empty universe is an unbounded narrative claim and is rejected.",
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/workItemId"}
    },
    "work_item_records": {
      "description": "One record per bound work item. A bound item with no record is unaccounted, never assumed covered.",
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/workItemRecord"}
    },
    "route_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "public_trace_event_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "claim_boundary": {"type": "string", "minLength": 1, "maxLength": 2048},
    "evidence_pointers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "receipt_canonical_sha256": {
      "description": "Canonical SHA-256 over this document with this field removed.",
      "oneOf": [{"const": ""}, {"$ref": "#/$defs/sha256"}]
    },
    "grants_application_evidence_authority": {"const": false},
    "grants_mathematical_authority": {"const": false},
    "grants_novelty_authority": {"const": false},
    "grants_tool_authority": {"const": false},
    "grants_review_independence_authority": {"const": false},
    "grants_promotion_authority": {"const": false},
    "requires_full_pr_diff_enumeration": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workItemId": {"type": "string", "minLength": 1, "maxLength": 256},
    "workItemRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_item_id",
        "kind",
        "disposition",
        "disposition_reason",
        "head_sha",
        "base_sha",
        "evidence_pointers"
      ],
      "properties": {
        "work_item_id": {"$ref": "#/$defs/workItemId"},
        "kind": {"enum": ["ISSUE", "PULL_REQUEST"]},
        "disposition": {
          "enum": ["INCLUDED", "REJECTED", "DEFERRED", "STACKED"]
        },
        "disposition_reason": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 1024}
          ]
        },
        "head_sha": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 256}
          ]
        },
        "base_sha": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 256}
          ]
        },
        "evidence_pointers": {
          "type": "array",
          "maxItems": 10000,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    }
  }
}
