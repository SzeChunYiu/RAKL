    "slurm_account": {"const": "lu2026-2-51"},
    "slurm_partition": {"const": "lu48"},
    "node": {"type": "string", "minLength": 1},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["python", "packages", "sentencepiece_available", "fast_tokenizer_probe_passed", "device", "dtype", "local_files_only"], "properties": {"python": {"type": "string"}, "packages": {"type": "object", "additionalProperties": {"type": "string"}}, "sentencepiece_available": {"type": "boolean"}, "fast_tokenizer_probe_passed": {"type": "boolean"}, "device": {"const": "cpu"}, "dtype": {"const": "float32"}, "local_files_only": {"const": true}}},
    "runtime_tree_sha256_before": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "runtime_tree_sha256_after": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
