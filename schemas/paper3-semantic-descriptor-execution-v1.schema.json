  "properties": {
    "schema_version": {"const": "paper3-semantic-descriptor-execution-v1"},
    "created_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "verdict": {"enum": ["DESCRIPTOR_EXECUTION_PASS", "DESCRIPTOR_EXECUTION_CANNOT_CHECK"]},
    "expected_repo_sha": {"$ref": "#/$defs/gitsha"},
