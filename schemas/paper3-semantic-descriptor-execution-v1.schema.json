    "failures": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "label_access": {"$ref": "#/$defs/label_access"},
    "training_authorized": {"const": false},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "allOf": [{"if": {"properties": {"verdict": {"const": "DESCRIPTOR_EXECUTION_PASS"}}}, "then": {"properties": {"runtime": {"properties": {"fast_tokenizer_probe_passed": {"const": true}}}, "descriptor_status": {"const": "READY"}, "descriptor_record_count": {"minimum": 1}, "failures": {"maxItems": 0}, "descriptor_path": {"type": "string", "minLength": 1}, "descriptor_sha256": {"$ref": "#/$defs/sha256"}, "model_files_before": {"minItems": 6, "maxItems": 6}, "model_files_after": {"minItems": 6, "maxItems": 6}, "runtime_tree_sha256_before": {"$ref": "#/$defs/sha256"}, "runtime_tree_sha256_after": {"$ref": "#/$defs/sha256"}}}, "else": {"properties": {"failures": {"minItems": 1}}}}],
  "$defs": {
