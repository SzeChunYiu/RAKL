    "label_access": {"type": "object", "additionalProperties": false, "required": ["external_annotation_accessed", "adjudication_accessed", "evaluated_result_accessed"], "properties": {"external_annotation_accessed": {"const": false}, "adjudication_accessed": {"const": false}, "evaluated_result_accessed": {"const": false}}}
  }
}
