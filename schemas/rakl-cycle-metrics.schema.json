{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/rakl-cycle-metrics.schema.json",
  "title": "RAKL cycle metrics v1",
  "description": "Stable prospective metrology record for one RAKL_math research cycle (#446 / Paper V longitudinal lane). Process evidence only: mints no theorem, tool, gluing, review-independence or scientific authority. Missing denominators and unavailable counters stay CANNOT_MEASURE with reason; they are never replaced by zero. Rates appear only where a frozen opportunity denominator is a non-negative integer. The longitudinal_performance_vector tracks five noncompensatory coordinate families and forbids a single scalar RAKL score.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cycle_id",
    "recorded_at_utc",
    "subjects",
    "opportunity_denominators",
    "retrieval",
    "action_change_attribution",
    "outcome",
    "reuse_funnel",
    "cost",
    "longitudinal_performance_vector",
    "claim_boundary",
    "grants_scientific_authority"
  ],
  "properties": {
    "schema_version": {"const": "rakl-cycle-metrics-v1"},
    "cycle_id": {"$ref": "#/$defs/identifier"},
    "recorded_at_utc": {"type": "string", "minLength": 1},
    "subjects": {"$ref": "#/$defs/subjects"},
    "opportunity_denominators": {"$ref": "#/$defs/opportunityDenominators"},
    "retrieval": {"$ref": "#/$defs/retrieval"},
    "action_change_attribution": {"$ref": "#/$defs/actionChangeAttribution"},
    "outcome": {"$ref": "#/$defs/outcome"},
    "reuse_funnel": {"$ref": "#/$defs/reuseFunnel"},
    "cost": {"$ref": "#/$defs/cost"},
    "longitudinal_performance_vector": {"$ref": "#/$defs/longitudinalPerformanceVector"},
    "retained_semantic_novelty": {
      "description": "Optional seven-axis retained-growth accounting. INTERNAL_METROLOGY until independent audit (#255).",
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/retainedSemanticNovelty"}]
    },
    "artifact_hash": {
      "description": "Canonical SHA-256 of this record with artifact_hash cleared or empty.",
      "oneOf": [{"const": ""}, {"$ref": "#/$defs/sha256"}]
    },
    "claim_boundary": {"$ref": "#/$defs/boundedRationale"},
    "grants_scientific_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 512},
    "boundedRationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\r\\n\\v\\f\\t\\u001c-\\u001e\\u2028\\u2029]+$"
    },
    "cannotMeasure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"const": "CANNOT_MEASURE"},
        "reason": {"$ref": "#/$defs/boundedRationale"}
      }
    },
    "measurableCount": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"$ref": "#/$defs/cannotMeasure"}
      ]
    },
    "measurableRate": {
      "description": "Rate permitted only when the corresponding opportunity denominator is a non-negative integer.",
      "oneOf": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"$ref": "#/$defs/cannotMeasure"}
      ]
    },
    "measurableBoolean": {
      "oneOf": [
        {"type": "boolean"},
        {"$ref": "#/$defs/cannotMeasure"}
      ]
    },
    "idListOrCannotMeasure": {
      "oneOf": [
        {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"}
        },
        {"$ref": "#/$defs/cannotMeasure"}
      ]
    },
    "subjects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework_sha",
        "method_version",
        "application_base_sha",
        "problem_root",
        "atom_id",
        "fibre_hash",
        "pre_action_receipt_hash"
      ],
      "properties": {
        "framework_sha": {"$ref": "#/$defs/gitSha"},
        "method_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "application_base_sha": {"$ref": "#/$defs/gitSha"},
        "application_result_sha": {
          "oneOf": [{"$ref": "#/$defs/gitSha"}, {"$ref": "#/$defs/cannotMeasure"}]
        },
        "problem_root": {"$ref": "#/$defs/identifier"},
        "atom_id": {"$ref": "#/$defs/identifier"},
        "fibre_hash": {"type": "string", "minLength": 1, "maxLength": 256},
        "pre_action_receipt_hash": {"$ref": "#/$defs/sha256"},
        "framework_repository": {"type": "string", "minLength": 1},
        "application_repository": {"type": "string", "minLength": 1},
        "candidate_id": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]
        }
      }
    },
    "opportunityDenominators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_memory_universe_count",
        "eligible_relevant_memory_ids",
        "eligible_negative_history_ids",
        "registered_route_options",
        "registered_falsifier_options"
      ],
      "properties": {
        "eligible_memory_universe_count": {"$ref": "#/$defs/measurableCount"},
        "eligible_relevant_memory_ids": {"$ref": "#/$defs/idListOrCannotMeasure"},
        "eligible_negative_history_ids": {"$ref": "#/$defs/idListOrCannotMeasure"},
        "registered_route_options": {"$ref": "#/$defs/measurableCount"},
        "registered_falsifier_options": {"$ref": "#/$defs/measurableCount"},
        "frozen_before_retrieval_at_utc": {"type": "string", "minLength": 1}
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrieved_count",
        "selected_count",
        "rejected_count",
        "missed_known_relevant_count",
        "relevant_root_recall",
        "counterevidence_recall",
        "same_root_duplicate_count",
        "stale_memory_selected_count"
      ],
      "properties": {
        "retrieved_count": {"$ref": "#/$defs/measurableCount"},
        "selected_count": {"$ref": "#/$defs/measurableCount"},
        "rejected_count": {"$ref": "#/$defs/measurableCount"},
        "missed_known_relevant_count": {"$ref": "#/$defs/measurableCount"},
        "relevant_root_recall": {"$ref": "#/$defs/measurableRate"},
        "counterevidence_recall": {"$ref": "#/$defs/measurableRate"},
        "same_root_duplicate_count": {"$ref": "#/$defs/measurableCount"},
        "stale_memory_selected_count": {"$ref": "#/$defs/measurableCount"},
        "retrieved_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"}
        },
        "selected_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"}
        },
        "rejected_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "actionChangeAttribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_memory_pre_gate_action_preference",
        "post_memory_action_preference",
        "post_governance_action",
        "memory_changed_action",
        "search_changed_action",
        "governance_changed_action"
      ],
      "properties": {
        "pre_memory_pre_gate_action_preference": {"$ref": "#/$defs/boundedRationale"},
        "post_memory_action_preference": {"$ref": "#/$defs/boundedRationale"},
        "post_governance_action": {"$ref": "#/$defs/boundedRationale"},
        "memory_changed_action": {"$ref": "#/$defs/measurableBoolean"},
        "search_changed_action": {"$ref": "#/$defs/measurableBoolean"},
        "governance_changed_action": {"$ref": "#/$defs/measurableBoolean"},
        "attribution_note": {
          "description": "Records that attribution is observational, not causal proof.",
          "const": "OBSERVATIONAL_NOT_CAUSAL"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_result_status",
        "residual_before",
        "residual_after",
        "residual_contracted",
        "new_valid_obligation_closed_count",
        "new_invalid_route_avoided_count",
        "false_transfer",
        "authority_leak",
        "posthoc_chronology"
      ],
      "properties": {
        "local_result_status": {
          "enum": [
            "SUCCESS",
            "PARTIAL_SUCCESS",
            "FAILURE",
            "BLOCKED",
            "CANNOT_CHECK",
            "UNKNOWN"
          ]
        },
        "residual_before": {"$ref": "#/$defs/boundedRationale"},
        "residual_after": {"$ref": "#/$defs/boundedRationale"},
        "residual_contracted": {"$ref": "#/$defs/measurableBoolean"},
        "new_valid_obligation_closed_count": {"$ref": "#/$defs/measurableCount"},
        "new_invalid_route_avoided_count": {"$ref": "#/$defs/measurableCount"},
        "false_transfer": {"$ref": "#/$defs/measurableBoolean"},
        "authority_leak": {"$ref": "#/$defs/measurableBoolean"},
        "posthoc_chronology": {"$ref": "#/$defs/measurableBoolean"},
        "root_status": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]
        }
      }
    },
    "reuseFunnel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_episode",
        "candidate_lesson",
        "verified_lesson",
        "admitted_lesson",
        "later_retrieved",
        "changed_action",
        "successful_fresh_reuse",
        "failed_reuse",
        "out_of_scope_reuse",
        "superseded_before_reuse"
      ],
      "properties": {
        "raw_episode": {"$ref": "#/$defs/measurableCount"},
        "candidate_lesson": {"$ref": "#/$defs/measurableCount"},
        "verified_lesson": {"$ref": "#/$defs/measurableCount"},
        "admitted_lesson": {"$ref": "#/$defs/measurableCount"},
        "later_retrieved": {"$ref": "#/$defs/measurableCount"},
        "changed_action": {"$ref": "#/$defs/measurableCount"},
        "successful_fresh_reuse": {"$ref": "#/$defs/measurableCount"},
        "failed_reuse": {"$ref": "#/$defs/measurableCount"},
        "out_of_scope_reuse": {"$ref": "#/$defs/measurableCount"},
        "superseded_before_reuse": {"$ref": "#/$defs/measurableCount"},
        "episode_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"}
        },
        "successful_fresh_reuse_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_input_tokens",
        "model_output_tokens",
        "model_calls",
        "retrieval_calls",
        "tool_calls",
        "wall_time_seconds",
        "provider_cost"
      ],
      "properties": {
        "model_input_tokens": {"$ref": "#/$defs/measurableCount"},
        "model_output_tokens": {"$ref": "#/$defs/measurableCount"},
        "model_calls": {"$ref": "#/$defs/measurableCount"},
        "retrieval_calls": {"$ref": "#/$defs/measurableCount"},
        "tool_calls": {"$ref": "#/$defs/measurableCount"},
        "wall_time_seconds": {"$ref": "#/$defs/measurableCount"},
        "provider_cost": {
          "oneOf": [
            {"type": "number", "minimum": 0},
            {"$ref": "#/$defs/cannotMeasure"}
          ]
        },
        "cost_unit": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "longitudinalPerformanceVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified_progress",
        "search_utility",
        "reuse_utility",
        "governance",
        "efficiency"
      ],
      "properties": {
        "verified_progress": {"$ref": "#/$defs/verifiedProgressComponents"},
        "search_utility": {"$ref": "#/$defs/searchUtilityComponents"},
        "reuse_utility": {"$ref": "#/$defs/reuseUtilityComponents"},
        "governance": {"$ref": "#/$defs/governanceComponents"},
        "efficiency": {"$ref": "#/$defs/efficiencyComponents"},
        "aggregate_scalar_score_forbidden": {"const": true}
      }
    },
    "verifiedProgressComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid_residual_contraction",
        "registered_obligation_closure_count",
        "local_scoped_result_rate"
      ],
      "properties": {
        "valid_residual_contraction": {"$ref": "#/$defs/measurableBoolean"},
        "registered_obligation_closure_count": {"$ref": "#/$defs/measurableCount"},
        "local_scoped_result_rate": {"$ref": "#/$defs/measurableRate"}
      }
    },
    "searchUtilityComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relevant_root_recall",
        "counterevidence_recall",
        "missed_relevant_memory_count",
        "route_change_rate"
      ],
      "properties": {
        "relevant_root_recall": {"$ref": "#/$defs/measurableRate"},
        "counterevidence_recall": {"$ref": "#/$defs/measurableRate"},
        "missed_relevant_memory_count": {"$ref": "#/$defs/measurableCount"},
        "route_change_rate": {"$ref": "#/$defs/measurableRate"}
      }
    },
    "reuseUtilityComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successful_fresh_reuse_count",
        "false_or_out_of_scope_reuse_count",
        "stale_reuse_count"
      ],
      "properties": {
        "successful_fresh_reuse_count": {"$ref": "#/$defs/measurableCount"},
        "false_or_out_of_scope_reuse_count": {"$ref": "#/$defs/measurableCount"},
        "stale_reuse_count": {"$ref": "#/$defs/measurableCount"}
      }
    },
    "governanceComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prospective_chronology_capture",
        "authority_leakage_observed",
        "evidence_root_binding_verified",
        "negative_history_preserved"
      ],
      "properties": {
        "prospective_chronology_capture": {"$ref": "#/$defs/measurableBoolean"},
        "authority_leakage_observed": {"$ref": "#/$defs/measurableBoolean"},
        "evidence_root_binding_verified": {"$ref": "#/$defs/measurableBoolean"},
        "negative_history_preserved": {"$ref": "#/$defs/measurableBoolean"}
      }
    },
    "efficiencyComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "progress_per_token",
        "progress_per_model_call",
        "progress_per_retrieval_call",
        "progress_per_wall_time"
      ],
      "properties": {
        "progress_per_token": {"$ref": "#/$defs/measurableRate"},
        "progress_per_model_call": {"$ref": "#/$defs/measurableRate"},
        "progress_per_retrieval_call": {"$ref": "#/$defs/measurableRate"},
        "progress_per_wall_time": {"$ref": "#/$defs/measurableRate"}
      }
    },
    "retainedSemanticNovelty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "KNOWLEDGE",
        "OPERATOR",
        "EXPERIENCE_PATTERN",
        "OBSTRUCTION",
        "RELATION",
        "PATH",
        "META_METHOD"
      ],
      "properties": {
        "KNOWLEDGE": {"type": "integer", "minimum": 0},
        "OPERATOR": {"type": "integer", "minimum": 0},
        "EXPERIENCE_PATTERN": {"type": "integer", "minimum": 0},
        "OBSTRUCTION": {"type": "integer", "minimum": 0},
        "RELATION": {"type": "integer", "minimum": 0},
        "PATH": {"type": "integer", "minimum": 0},
        "META_METHOD": {"type": "integer", "minimum": 0},
        "novelty_authority": {"const": "INTERNAL_METROLOGY"}
      }
    }
  }
}
