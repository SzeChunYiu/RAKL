{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/state_transition_receipt.schema.json",
  "title": "ORION StateTransitionReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "before_snapshot_id",
    "after_snapshot_id",
    "action",
    "action_payload_hash",
    "idempotency_key",
    "request_hash",
    "process_identity",
    "read_set",
    "write_set",
    "produced_artifact_ids",
    "metric_receipt_ids",
    "residual_ids",
    "status",
    "reasons",
    "created_at_utc",
    "transition_id"
  ],
  "properties": {
    "schema_version": {
      "const": "orion-engineering-state-v2"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "before_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "after_snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "action_payload_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "process_identity": {
      "type": "string",
      "minLength": 1
    },
    "read_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "write_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "produced_artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metric_receipt_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "residual_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "COMMITTED",
        "ABORTED",
        "RETRY_REQUIRED",
        "RECOVERY_REQUIRED",
        "CANNOT_CHECK"
      ]
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "transition_id": {
      "type": "string",
      "pattern": "^transition:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "COMMITTED"
          }
        }
      },
      "then": {
        "properties": {
          "after_snapshot_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "after_snapshot_id": {
            "type": "null"
          }
        }
      }
    }
  ]
}
