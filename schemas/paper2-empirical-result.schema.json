{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper2-empirical-result.schema.json",
  "title": "RAKL Paper 2 matched scientific-process result receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment_id", "subject_sha", "created_at_utc", "frozen_protocol_id", "records"],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "subject_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "frozen_protocol_id": {"type": "string", "minLength": 1},
    "provider_price_sheet_id": {"type": ["string", "null"]},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/run"}}
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "seed",
        "architecture_arm",
        "evidence_access_arm",
        "evidence_topology",
        "base_model_id",
        "final_task_correct",
        "valid_scientific_success",
        "hidden_defect_detected",
        "unsupported_authority_upgrade",
        "mandatory_evidence_omitted",
        "counterevidence_uptake",
        "negative_history_preserved",
        "false_block",
        "missed_block",
        "input_tokens",
        "output_tokens",
        "tool_calls",
        "retrieval_calls",
        "wall_time_ms"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "architecture_arm": {"type": "string", "minLength": 1},
        "evidence_access_arm": {"enum": ["public", "curated", "complete_sealed"]},
        "evidence_topology": {"type": "string", "minLength": 1},
        "base_model_id": {"type": "string", "minLength": 1},
        "final_task_correct": {"type": "boolean"},
        "valid_scientific_success": {"type": "boolean"},
        "hidden_defect_detected": {"type": ["boolean", "null"]},
        "unsupported_authority_upgrade": {"type": "boolean"},
        "mandatory_evidence_omitted": {"type": "boolean"},
        "counterevidence_uptake": {"type": ["boolean", "null"]},
        "negative_history_preserved": {"type": ["boolean", "null"]},
        "false_block": {"type": "boolean"},
        "missed_block": {"type": "boolean"},
        "context_qoi_failure": {"type": ["boolean", "null"]},
        "evaluator_identity_failure": {"type": ["boolean", "null"]},
        "ontology_discovery_miss": {"type": ["boolean", "null"]},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "retrieval_query_tokens": {"type": ["integer", "null"], "minimum": 0},
        "embedding_reranking_tokens": {"type": ["integer", "null"], "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "retrieval_calls": {"type": "integer", "minimum": 0},
        "retrieved_bytes": {"type": ["integer", "null"], "minimum": 0},
        "wall_time_ms": {"type": "integer", "minimum": 0},
        "provider_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "preprocessing_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "failure_reason": {"type": ["string", "null"]}
      }
    }
  }
}
