{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper3-annotation-import-receipt.schema.json",
  "title": "Paper 3 annotation import receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_sha",
    "protocol_id",
    "protocol_sha256",
    "source_set_sha256",
    "packet_sha256",
    "submission_sha256",
    "adjudication_sha256",
    "provenance_audit_sha256",
    "negative_history_benchmark_sha256",
    "passed",
    "failures",
    "coordinate_exact_agreement",
    "coordinate_conflict_count",
    "benchmark_sha256",
    "training_authorized"
  ],
  "properties": {
    "schema_version": {
      "const": "paper3-annotation-import-receipt-v2"
    },
    "subject_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "protocol_id": {
      "const": "paper3-confirmatory-gate-v2"
    },
    "protocol_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "packet_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "submission_sha256": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "adjudication_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provenance_audit_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "negative_history_benchmark_sha256": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "passed": {
      "type": "boolean"
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coordinate_exact_agreement": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "coordinate_conflict_count": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "benchmark_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "training_authorized": {
      "const": false
    },
    "annotator_class": {
      "type": "string",
      "enum": [
        "HUMAN_OR_DOMAIN_EXPERT",
        "AI_OPERATOR"
      ]
    },
    "independent_external_human": {
      "type": "boolean"
    },
    "same_session_critique_not_independent_review": {
      "type": "boolean"
    },
    "annotation_authority_class": {
      "type": "string",
      "enum": [
        "CONFIRMATORY_INDEPENDENT",
        "DEMOTED_AI_OPERATOR"
      ]
    },
    "demoted_training_eligible": {
      "type": "boolean"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
