{
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper2-cpu-staging-construction-receipt-v3-2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "construction_parent_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "contract_canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "contract_file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "evaluated_result_record_count": {
      "const": 0
    },
    "jobs_submitted": {
      "const": 0
    },
    "model_execution_performed": {
      "const": false
    },
    "schema_version": {
      "const": "paper2-cpu-staging-construction-receipt-v3.2"
    },
    "verdict": {
      "const": "REPAIR_READY_NOT_SUBMITTED"
    }
  },
  "required": [
    "schema_version",
    "created_at_utc",
    "construction_parent_sha",
    "contract_file_sha256",
    "contract_canonical_sha256",
    "jobs_submitted",
    "model_execution_performed",
    "evaluated_result_record_count",
    "verdict"
  ],
  "title": "Paper 2 CPU staging V3.2 construction receipt",
  "type": "object"
}
