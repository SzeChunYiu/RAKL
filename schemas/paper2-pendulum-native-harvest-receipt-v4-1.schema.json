{
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper2-pendulum-native-harvest-receipt-v4-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "nullable_sha256": {"anyOf": [{"pattern": "^[0-9a-f]{64}$", "type": "string"}, {"type": "null"}]},
    "path_hash": {
      "additionalProperties": false,
      "properties": {
        "path": {"minLength": 1, "type": "string"},
        "sha256": {"$ref": "#/$defs/nullable_sha256"}
      },
      "required": ["path", "sha256"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allocated_preflight_receipt": {"$ref": "#/$defs/path_hash"},
    "arm_record_count": {"maximum": 2, "minimum": 0, "type": "integer"},
    "claim_boundary": {"minLength": 1, "type": "string"},
    "created_at_utc": {"format": "date-time", "type": "string"},
    "evaluated_task_seed_unit_count": {"maximum": 1, "minimum": 0, "type": "integer"},
    "execution_checkout": {"anyOf": [{"type": "object"}, {"type": "null"}]},
    "execution_packet": {"$ref": "#/$defs/path_hash"},
    "failures": {"items": {"type": "string"}, "type": "array"},
    "output_normalization_policy_id": {"const": "PENDULUM_EXACT_JSON_OR_SINGLE_LOWERCASE_JSON_FENCE_V4_1"},
    "packet_parent_sha": {"anyOf": [{"pattern": "^[0-9a-f]{40}$", "type": "string"}, {"type": "null"}]},
    "parse_valid_arm_count": {"maximum": 2, "minimum": 0, "type": "integer"},
    "result_receipt": {"$ref": "#/$defs/path_hash"},
    "run_manifest": {"$ref": "#/$defs/path_hash"},
    "scheduler_evidence": {"type": "object"},
    "schema_version": {"const": "paper2-pendulum-native-harvest-receipt-v4.1"},
    "scorable_arm_count": {"maximum": 2, "minimum": 0, "type": "integer"},
    "seed": {"const": 17},
    "slurm_job_id": {"pattern": "^[0-9]+$", "type": "string"},
    "snapshot_attestations": {
      "additionalProperties": false,
      "properties": {
        "post_path": {"minLength": 1, "type": "string"},
        "post_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "pre_path": {"minLength": 1, "type": "string"},
        "pre_sha256": {"$ref": "#/$defs/nullable_sha256"}
      },
      "required": ["pre_path", "pre_sha256", "post_path", "post_sha256"],
      "type": "object"
    },
    "submission_receipt": {"$ref": "#/$defs/path_hash"},
    "task_id": {"const": "PENDULUM_SEALED_KNOWN_ANSWER_001"},
    "task_seed_receipt": {"$ref": "#/$defs/path_hash"},
    "v4_reinterpretation_permitted": {"const": false},
    "verdict": {"enum": ["HARVEST_V4_1_TASK_SEED_PASS_NONCONFIRMATORY", "HARVEST_V4_1_CANNOT_CHECK"]}
  },
  "required": [
    "schema_version", "created_at_utc", "slurm_job_id", "verdict", "failures",
    "scheduler_evidence", "execution_packet", "output_normalization_policy_id",
    "v4_reinterpretation_permitted", "packet_parent_sha", "execution_checkout",
    "task_id", "seed", "submission_receipt", "allocated_preflight_receipt",
    "run_manifest", "result_receipt", "task_seed_receipt", "snapshot_attestations",
    "evaluated_task_seed_unit_count", "arm_record_count", "parse_valid_arm_count",
    "scorable_arm_count", "claim_boundary"
  ],
  "type": "object"
}
