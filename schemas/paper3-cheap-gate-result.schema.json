{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper3-cheap-gate-result.schema.json",
  "title": "RAKL Paper 3 cheap structural-signal gate receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "experiment_id",
    "subject_sha",
    "created_at_utc",
    "frozen_protocol_id",
    "protocol_sha256",
    "benchmark_id",
    "benchmark_sha256",
    "claim_boundary",
    "split",
    "arm_metrics",
    "predictions",
    "annotation_gate",
    "diagnostic_signal_gate",
    "overall_cheap_gate_passed",
    "expensive_training_authorized",
    "gate_verdict",
    "execution_cost",
    "negative_history"
  ],
  "properties": {
    "schema_version": {"const": "paper3-cheap-gate-result-v1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "subject_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "frozen_protocol_id": {"type": "string", "minLength": 1},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "benchmark_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "split": {"const": "leave_one_family_out"},
    "family_count": {"type": "integer", "minimum": 2},
    "case_count": {"type": "integer", "minimum": 1},
    "arm_metrics": {"type": "object", "minProperties": 4},
    "predictions": {"type": "array", "minItems": 1},
    "annotation_gate": {"type": "object", "required": ["passed", "reason"]},
    "diagnostic_signal_gate": {"type": "object", "required": ["passed", "checks"]},
    "overall_cheap_gate_passed": {"type": "boolean"},
    "expensive_training_authorized": {"type": "boolean"},
    "gate_verdict": {"type": "string", "minLength": 1},
    "execution_cost": {"type": "object"},
    "negative_history": {"type": "array"}
  }
}
