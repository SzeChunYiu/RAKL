{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/knowledge_acquisition_round.schema.json",
  "title": "KnowledgeAcquisitionRound",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "round_id",
    "route_family",
    "mode",
    "independent_route",
    "query_ids",
    "source_ids",
    "relevant_source_ids",
    "retained_semantic_ids",
    "cost_policy_id",
    "cost",
    "evidence_pointers",
    "residual_ids"
  ],
  "properties": {
    "round_id": {"type": "string", "minLength": 1},
    "route_family": {"type": "string", "minLength": 1},
    "mode": {"enum": ["INITIAL_BROAD", "RESIDUAL_TARGETED", "FRESHNESS_REFRESH", "APPLE_JUMP"]},
    "independent_route": {"type": "boolean"},
    "query_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "relevant_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "retained_semantic_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "new_facet_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "default": []},
    "new_mechanism_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "default": []},
    "new_context_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "default": []},
    "new_contradiction_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "default": []},
    "new_falsifier_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "default": []},
    "new_blind_spot_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "default": []},
    "cost_policy_id": {"type": "string", "minLength": 1},
    "cost": {"type": "number", "minimum": 0},
    "evidence_pointers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "residual_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
