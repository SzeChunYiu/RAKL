{
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper2-pendulum-native-harvest-receipt-v4.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arm_record_count": {
      "maximum": 2,
      "minimum": 0,
      "type": "integer"
    },
    "claim_boundary": {
      "minLength": 1,
      "type": "string"
    },
    "created_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "evaluated_task_seed_unit_count": {
      "maximum": 1,
      "minimum": 0,
      "type": "integer"
    },
    "execution_checkout": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "failures": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "packet_parent_sha": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "result_receipt": {
      "type": "object"
    },
    "scheduler_evidence": {
      "type": "object"
    },
    "schema_version": {
      "const": "paper2-pendulum-native-harvest-receipt-v4"
    },
    "seed": {
      "const": 17
    },
    "slurm_job_id": {
      "pattern": "^[0-9]+$",
      "type": "string"
    },
    "snapshot_attestations": {
      "type": "object"
    },
    "task_id": {
      "const": "PENDULUM_SEALED_KNOWN_ANSWER_001"
    },
    "task_seed_receipt": {
      "type": "object"
    },
    "verdict": {
      "enum": [
        "HARVEST_TASK_SEED_PASS_NONCONFIRMATORY",
        "HARVEST_CANNOT_CHECK"
      ]
    }
  },
  "required": [
    "schema_version",
    "created_at_utc",
    "slurm_job_id",
    "verdict",
    "failures",
    "scheduler_evidence",
    "packet_parent_sha",
    "execution_checkout",
    "task_id",
    "seed",
    "result_receipt",
    "task_seed_receipt",
    "snapshot_attestations",
    "evaluated_task_seed_unit_count",
    "arm_record_count",
    "claim_boundary"
  ],
  "type": "object"
}
