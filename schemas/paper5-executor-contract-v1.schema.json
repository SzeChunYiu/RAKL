{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakl.invalid/schemas/paper5-executor-contract-v1.schema.json",
  "title": "Paper 5 generic attribution executor contract",
  "description": "Prospective binding for the provider/environment-specific adapter used by the Paper 5 four-arm runner. This contract grants no scientific claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "tasks_sha256",
    "schedule_sha256",
    "adapter_path",
    "adapter_sha256",
    "model_id",
    "model_revision",
    "evaluator_protocol_hash",
    "tool_policy_id",
    "source_cutoff_id",
    "arm_state_hashes",
    "resource_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "paper5-executor-contract-v1"},
    "packet_id": {"type": "string", "minLength": 1},
    "tasks_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schedule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter_path": {"type": "string", "minLength": 1},
    "adapter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_id": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "evaluator_protocol_hash": {"type": "string", "minLength": 1},
    "tool_policy_id": {"type": "string", "minLength": 1},
    "source_cutoff_id": {"type": "string", "minLength": 1},
    "arm_state_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["MODEL_ONLY", "RAKL_RESET", "RAKL_SHAM_MEMORY", "RAKL_LEARNING"],
      "properties": {
        "MODEL_ONLY": {"type": "string", "minLength": 1},
        "RAKL_RESET": {"type": "string", "minLength": 1},
        "RAKL_SHAM_MEMORY": {"type": "string", "minLength": 1},
        "RAKL_LEARNING": {"type": "string", "minLength": 1}
      }
    },
    "resource_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_input_tokens",
        "model_output_tokens",
        "preprocessing_model_tokens",
        "tool_calls",
        "retrieval_calls",
        "wall_time_ms"
      ],
      "properties": {
        "model_input_tokens": {"type": "integer", "minimum": 1},
        "model_output_tokens": {"type": "integer", "minimum": 1},
        "preprocessing_model_tokens": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "retrieval_calls": {"type": "integer", "minimum": 0},
        "wall_time_ms": {"type": "integer", "minimum": 1}
      }
    }
  }
}
