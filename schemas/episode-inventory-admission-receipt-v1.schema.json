{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/episode-inventory-admission-receipt-v1.schema.json",
  "title": "RAKL episode inventory admission receipt v1",
  "description": "Proposal-only, framework-process telemetry separating proposal/shadow TaskEpisode storage from canonical episode-inventory admission. Mints no proof, lesson, tool, gluing, theorem, review-independence or framework authority. Path, file extension and omitted episode_id are not authority mechanisms. The companion runtime is rakl.episode_inventory_admission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "episode_id",
    "episode_artifact_hash",
    "storage_status",
    "claim_boundary",
    "admission_attestation_id",
    "evidence_pointers",
    "frozen_at_utc",
    "receipt_canonical_sha256",
    "grants_proof_authority",
    "grants_lesson_tool_authority",
    "grants_framework_authority",
    "path_or_extension_is_not_authority"
  ],
  "properties": {
    "schema_version": {"const": "episode-inventory-admission-receipt-v1"},
    "receipt_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "episode_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "episode_artifact_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "storage_status": {
      "description": "PROPOSAL_SHADOW_STORED may be retained for search/failure learning but must not satisfy canonical inventory or protected gates. CANONICAL_INVENTORY_ADMITTED requires an explicit admission_attestation_id.",
      "enum": ["PROPOSAL_SHADOW_STORED", "CANONICAL_INVENTORY_ADMITTED"]
    },
    "claim_boundary": {"type": "string", "minLength": 1, "maxLength": 2048},
    "admission_attestation_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 512}
      ]
    },
    "evidence_pointers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "frozen_at_utc": {"type": "string", "minLength": 1, "maxLength": 64, "format": "date-time"},
    "receipt_canonical_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "grants_proof_authority": {"const": false},
    "grants_lesson_tool_authority": {"const": false},
    "grants_framework_authority": {"const": false},
    "path_or_extension_is_not_authority": {"const": true}
  },
  "allOf": [
    {
      "if": {
        "properties": {"storage_status": {"const": "CANONICAL_INVENTORY_ADMITTED"}}
      },
      "then": {
        "properties": {
          "admission_attestation_id": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    {
      "if": {
        "properties": {"storage_status": {"const": "PROPOSAL_SHADOW_STORED"}}
      },
      "then": {
        "properties": {"admission_attestation_id": {"type": "null"}}
      }
    }
  ]
}
