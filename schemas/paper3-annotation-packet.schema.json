{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rakl/paper3-annotation-packet.schema.json",
  "title": "Paper 3 external annotation packet v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "parent_subject_sha", "source_set_id", "source_set_sha256", "source_set_frozen_at_utc", "frozen_at_utc", "protocol_id", "protocol_sha256", "rubric_id", "rubric_sha256", "negative_history_benchmark_sha256", "authority_status", "claim_boundary", "instructions", "items"],
  "properties": {
    "schema_version": {"const": "paper3-external-annotation-packet-v2"},
    "packet_id": {"type": "string", "minLength": 1},
    "parent_subject_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_set_id": {"type": "string", "minLength": 1},
    "source_set_sha256": {"$ref": "#/$defs/sha256"},
    "source_set_frozen_at_utc": {"$ref": "#/$defs/utcTimestamp"},
    "frozen_at_utc": {"$ref": "#/$defs/utcTimestamp"},
    "protocol_id": {"const": "paper3-confirmatory-gate-v2"},
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "rubric_id": {"type": "string", "minLength": 1},
    "rubric_sha256": {"$ref": "#/$defs/sha256"},
    "negative_history_benchmark_sha256": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "authority_status": {"const": "awaiting_genuinely_independent_annotation"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_independent_submissions_per_item", "distinct_adjudicator_required", "external_provenance_audit_required", "direct_identifiers_prohibited", "judgement_fields", "cannot_assess_fails_confirmatory_eligibility"],
      "properties": {
        "required_independent_submissions_per_item": {"type": "integer", "minimum": 2},
        "distinct_adjudicator_required": {"const": true},
        "external_provenance_audit_required": {"const": true},
        "direct_identifiers_prohibited": {"const": true},
        "judgement_fields": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "cannot_assess_fails_confirmatory_eligibility": {"const": true}
      }
    },
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/packetItem"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utcTimestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "packetItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "family", "source_domain", "target_domain", "qoi", "source_evidence", "target_evidence"],
      "properties": {
        "item_id": {"type": "string", "pattern": "^p3item-[0-9a-f]{20}$"},
        "family": {"type": "string", "minLength": 1},
        "source_domain": {"type": "string", "minLength": 1},
        "target_domain": {"type": "string", "minLength": 1},
        "source_surface_terms": {"$ref": "#/$defs/nonEmptyStrings"},
        "target_surface_terms": {"$ref": "#/$defs/nonEmptyStrings"},
        "source_skill_tags": {"$ref": "#/$defs/nonEmptyStrings"},
        "target_skill_tags": {"$ref": "#/$defs/nonEmptyStrings"},
        "source_dependencies": {"$ref": "#/$defs/nonEmptyStrings"},
        "target_dependencies": {"$ref": "#/$defs/nonEmptyStrings"},
        "candidate_load_bearing_invariant": {"type": "string", "minLength": 1},
        "candidate_load_bearing_boundary": {"type": "string", "minLength": 1},
        "qoi": {"type": "string", "minLength": 1},
        "source_evidence": {"$ref": "#/$defs/nonEmptyStrings"},
        "target_evidence": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    }
  }
}
