{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/pre-scratch-chronology-qoi-v1.schema.json",
  "title": "RAKL pre-scratch chronology QoI stub v1",
  "description": "Prospective process QoI instrumentation stub: fraction of consequential hypotheses where durable pre-action receipt timestamp strictly precedes first hypothesis exposure. validation_status is NOT_VALIDATED_STUB until a fresh prospective discriminator is executed. Companion runtime: rakl.pre_scratch_fibre_freeze.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict",
    "consequential_hypothesis_count",
    "prospective_pre_exposure_count",
    "prospective_pre_exposure_fraction",
    "validation_status",
    "reasons",
    "report_canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "pre-scratch-chronology-qoi-v1"},
    "verdict": {"enum": ["COMPUTED", "CANNOT_CHECK"]},
    "consequential_hypothesis_count": {"type": "integer", "minimum": 0},
    "prospective_pre_exposure_count": {"type": "integer", "minimum": 0},
    "prospective_pre_exposure_fraction": {"type": ["number", "null"]},
    "validation_status": {"const": "NOT_VALIDATED_STUB"},
    "reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "report_canonical_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
