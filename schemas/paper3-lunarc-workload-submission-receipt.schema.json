{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper3-lunarc-workload-submission-receipt.schema.json",
  "title": "Paper 3 LUNARC workload submission receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "created_at_utc", "experiment_id", "workload",
    "model_mode", "manifest_sha256", "gate_receipt_sha256", "subject_sha",
    "execution_host", "account", "partition", "fs9_output_dir",
    "batch_script_sha256", "failures", "submitted", "slurm_job_id", "verdict"
  ],
  "properties": {
    "schema_version": {"const": "paper3-lunarc-workload-submission-receipt-v1"},
    "created_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "experiment_id": {"type": ["string", "null"]},
    "workload": {"type": ["string", "null"]},
    "model_mode": {"type": ["string", "null"]},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject_sha": {"type": ["string", "null"]},
    "execution_host": {"type": "string", "minLength": 1},
    "account": {"type": ["string", "null"]},
    "partition": {"type": ["string", "null"]},
    "fs9_output_dir": {"type": ["string", "null"]},
    "batch_script_sha256": {"type": ["string", "null"]},
    "failures": {"type": "array", "items": {"type": "string"}},
    "submitted": {"type": "boolean"},
    "slurm_job_id": {"type": ["string", "null"]},
    "verdict": {"enum": ["REFUSE_GATE_CLOSED", "REFUSE_PREFLIGHT_VALIDATION", "READY_NOT_SUBMITTED", "SUBMISSION_FAILED", "SUBMITTED_AFTER_EXACT_GATE_PASS"]},
    "sbatch_argv": {"type": "array", "items": {"type": "string"}},
    "submission_error_type": {"type": "string", "minLength": 1}
  }
}
