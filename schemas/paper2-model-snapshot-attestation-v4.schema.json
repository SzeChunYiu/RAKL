{
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper2-model-snapshot-attestation-v4.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_boundary": {
      "minLength": 1,
      "type": "string"
    },
    "created_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "execution_checkout": {
      "additionalProperties": false,
      "properties": {
        "head_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "status_entry_count": {
          "const": 0
        },
        "tree_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "head_sha",
        "tree_sha",
        "status_entry_count"
      ],
      "type": "object"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "enum": [
              "model",
              "tokenizer"
            ]
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "role",
          "path",
          "bytes",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 8,
      "minItems": 8,
      "type": "array"
    },
    "packet_parent_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "phase": {
      "enum": [
        "PRE_INFERENCE",
        "POST_INFERENCE"
      ]
    },
    "result_receipt_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": "paper2-model-snapshot-attestation-v4"
    },
    "snapshot_canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "snapshot_path": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "created_at_utc",
    "phase",
    "packet_parent_sha",
    "execution_checkout",
    "snapshot_path",
    "files",
    "snapshot_canonical_sha256",
    "result_receipt_sha256",
    "claim_boundary"
  ],
  "type": "object"
}
