{
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/paper2-cpu-staging-contract-v3-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_status": {
      "const": "repair_ready_not_submitted"
    },
    "bindings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "sha256_mode": {
            "const": "canonical_contract_with_self_sha256_zeroed"
          }
        },
        "required": [
          "role",
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 16,
      "type": "array",
      "uniqueItems": true
    },
    "bootstrap_policy": {
      "additionalProperties": {
        "const": true,
        "type": "boolean"
      },
      "required": [
        "exact_repo_sha_required",
        "exact_origin_url_required",
        "detached_checkout_required",
        "clean_tree_required",
        "atomic_candidate_promotion_required",
        "successful_bootstrap_receipt_required_before_submission",
        "existing_repo_never_silently_mutated"
      ],
      "type": "object"
    },
    "candidate_root": {
      "const": "/projects/hep/fs9/users/scyiu/RAKL-paper2/assets/.paper2-cpu-v3-1-candidate"
    },
    "claim_boundary": {
      "minLength": 1,
      "type": "string"
    },
    "construction_parent_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "contract_id": {
      "const": "PAPER2_CPU_STAGING_V3_1"
    },
    "created_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "failure_policy": {
      "additionalProperties": {
        "const": true,
        "type": "boolean"
      },
      "required": [
        "preserve_failed_candidate_and_receipt",
        "never_reuse_existing_candidate_or_final",
        "partial_submission_job_id_must_be_receipted",
        "preserve_v3_failure_lineage"
      ],
      "type": "object"
    },
    "failure_root": {
      "const": "/projects/hep/fs9/users/scyiu/RAKL-paper2/failures/v3_1"
    },
    "final_root": {
      "const": "/projects/hep/fs9/users/scyiu/RAKL-paper2/assets/paper2-cpu-v3-1"
    },
    "fs9_root": {
      "const": "/projects/hep/fs9/users/scyiu/RAKL-paper2"
    },
    "model_execution_permitted": {
      "const": false
    },
    "predecessor_failure": {
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "const": "PAPER2_CPU_STAGING_V3"
        },
        "first_missing_artifact": {
          "const": "wheel:torch==2.8.0+cpu"
        },
        "http_status": {
          "const": 403
        },
        "localization_authority": {
          "const": "bounded_inference_from_first_missing_manifest_artifact_not_direct_failure-receipt_proof"
        },
        "preserved_candidate_path": {
          "const": "/projects/hep/fs9/users/scyiu/RAKL-paper2/assets/.paper2-cpu-v3-candidate-3475081"
        },
        "probe_job_id": {
          "const": "3475080"
        },
        "staging_job_id": {
          "const": "3475081"
        },
        "staging_verdict": {
          "const": "STAGING_FAILED_PRESERVED"
        }
      },
      "required": [
        "contract_id",
        "probe_job_id",
        "staging_job_id",
        "staging_verdict",
        "http_status",
        "preserved_candidate_path",
        "first_missing_artifact",
        "localization_authority"
      ],
      "type": "object"
    },
    "promotion_policy": {
      "additionalProperties": {
        "const": true,
        "type": "boolean"
      },
      "required": [
        "same_filesystem_candidate_and_final_required",
        "final_must_not_exist",
        "atomic_rename_required",
        "all_artifacts_hash_and_size_verified_before_promotion",
        "offline_hash_locked_install_required",
        "installed_version_equality_required"
      ],
      "type": "object"
    },
    "receipt_root": {
      "const": "/projects/hep/fs9/users/scyiu/RAKL-paper2/receipts/v3_1"
    },
    "repair_boundary": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "paper2-cpu-staging-contract-v3.1"
    },
    "staging_attestation_policy": {
      "additionalProperties": false,
      "properties": {
        "construction_parent_ancestor_required": {
          "const": true
        },
        "full_distribution_set_equality_required": {
          "const": true
        },
        "minimum_free_bytes": {
          "minimum": 6000000000,
          "type": "integer"
        },
        "pip_check_required": {
          "const": true
        },
        "pip_freeze_all_required": {
          "const": true
        },
        "platform_architecture": {
          "const": "x86_64"
        },
        "repository_tree_sha_required": {
          "const": true
        },
        "tensor_device": {
          "const": "cpu"
        },
        "torch_cuda_must_be_null": {
          "const": true
        },
        "torch_version": {
          "const": "2.8.0+cpu"
        }
      },
      "required": [
        "minimum_free_bytes",
        "pip_check_required",
        "full_distribution_set_equality_required",
        "pip_freeze_all_required",
        "torch_version",
        "torch_cuda_must_be_null",
        "tensor_device",
        "platform_architecture",
        "repository_tree_sha_required",
        "construction_parent_ancestor_required"
      ],
      "type": "object"
    },
    "submission_policy": {
      "additionalProperties": false,
      "properties": {
        "clean_checkout_required": {
          "const": true
        },
        "default_operator_mode": {
          "const": "READY_NOT_SUBMITTED"
        },
        "exact_repo_sha_required": {
          "const": true
        },
        "lunarc_login_host_required": {
          "const": true
        },
        "network_probe_must_precede_staging": {
          "const": true
        },
        "observed_account_partition_association_required": {
          "const": true
        },
        "retry_requires_new_explicit_operator_action": {
          "const": true
        }
      },
      "required": [
        "exact_repo_sha_required",
        "clean_checkout_required",
        "lunarc_login_host_required",
        "observed_account_partition_association_required",
        "network_probe_must_precede_staging",
        "default_operator_mode",
        "retry_requires_new_explicit_operator_action"
      ],
      "type": "object"
    },
    "supersedes_contract_id": {
      "const": "PAPER2_CPU_STAGING_V3"
    }
  },
  "required": [
    "schema_version",
    "contract_id",
    "supersedes_contract_id",
    "authority_status",
    "construction_parent_sha",
    "created_at_utc",
    "fs9_root",
    "candidate_root",
    "final_root",
    "receipt_root",
    "failure_root",
    "model_execution_permitted",
    "bootstrap_policy",
    "submission_policy",
    "predecessor_failure",
    "promotion_policy",
    "staging_attestation_policy",
    "failure_policy",
    "bindings",
    "claim_boundary",
    "repair_boundary"
  ],
  "title": "Paper 2 CPU staging V3.1 repair contract",
  "type": "object"
}
