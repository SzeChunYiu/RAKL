{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/epistemic-saturation.schema.json",
  "title": "RAKL Bounded Epistemic Saturation Record",
  "type": "object",
  "required": [
    "basis_fingerprint",
    "status",
    "required_consecutive_flat_rounds",
    "rounds",
    "absolute_complete"
  ],
  "properties": {
    "basis_fingerprint": {"type": "string", "minLength": 64, "maxLength": 64},
    "status": {"enum": ["OPEN", "BOUNDED_SATURATED", "INVALID_BASIS"]},
    "required_consecutive_flat_rounds": {"type": "integer", "minimum": 1},
    "required_freshness_cutoff": {"type": ["string", "null"], "format": "date"},
    "absolute_complete": {"const": false},
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "round_id",
          "basis_fingerprint",
          "growth",
          "bounded_discovery_closed",
          "route_coverage_stable",
          "omission_audit_passed",
          "nearest_work_audit_passed",
          "operator_order_audit",
          "freshness_cutoff",
          "blocking_fibers"
        ],
        "properties": {
          "round_id": {"type": "string", "minLength": 1},
          "basis_fingerprint": {"type": "string", "minLength": 64, "maxLength": 64},
          "growth": {
            "type": "object",
            "required": [
              "mechanisms_added",
              "derivations_added",
              "independent_evidence_roots_added",
              "contradictions_or_counterexamples_added",
              "negative_results_added",
              "novelty_boundary_updates",
              "assumption_scope_updates",
              "unresolved_fiber_updates",
              "discovery_route_updates"
            ],
            "additionalProperties": false,
            "properties": {
              "mechanisms_added": {"type": "integer", "minimum": 0},
              "derivations_added": {"type": "integer", "minimum": 0},
              "independent_evidence_roots_added": {"type": "integer", "minimum": 0},
              "contradictions_or_counterexamples_added": {"type": "integer", "minimum": 0},
              "negative_results_added": {"type": "integer", "minimum": 0},
              "novelty_boundary_updates": {"type": "integer", "minimum": 0},
              "assumption_scope_updates": {"type": "integer", "minimum": 0},
              "unresolved_fiber_updates": {"type": "integer", "minimum": 0},
              "discovery_route_updates": {"type": "integer", "minimum": 0}
            }
          },
          "bounded_discovery_closed": {"type": "boolean"},
          "route_coverage_stable": {"type": "boolean"},
          "omission_audit_passed": {"type": "boolean"},
          "nearest_work_audit_passed": {"type": "boolean"},
          "operator_order_audit": {
            "type": "object",
            "required": [
              "audit_id",
              "expand_then_consolidate_digest",
              "consolidate_then_expand_digest",
              "substantive_difference",
              "evidence_ids"
            ],
            "properties": {
              "audit_id": {"type": "string", "minLength": 1},
              "expand_then_consolidate_digest": {"type": "string", "minLength": 1},
              "consolidate_then_expand_digest": {"type": "string", "minLength": 1},
              "substantive_difference": {
                "type": "object",
                "required": [
                  "mechanisms_added",
                  "derivations_added",
                  "independent_evidence_roots_added",
                  "contradictions_or_counterexamples_added",
                  "negative_results_added",
                  "novelty_boundary_updates",
                  "assumption_scope_updates",
                  "unresolved_fiber_updates",
                  "discovery_route_updates"
                ],
                "additionalProperties": false,
                "properties": {
                  "mechanisms_added": {"type": "integer", "minimum": 0},
                  "derivations_added": {"type": "integer", "minimum": 0},
                  "independent_evidence_roots_added": {"type": "integer", "minimum": 0},
                  "contradictions_or_counterexamples_added": {"type": "integer", "minimum": 0},
                  "negative_results_added": {"type": "integer", "minimum": 0},
                  "novelty_boundary_updates": {"type": "integer", "minimum": 0},
                  "assumption_scope_updates": {"type": "integer", "minimum": 0},
                  "unresolved_fiber_updates": {"type": "integer", "minimum": 0},
                  "discovery_route_updates": {"type": "integer", "minimum": 0}
                }
              },
              "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          },
          "freshness_cutoff": {"type": "string", "format": "date"},
          "blocking_fibers": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "representation_only_changes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
