{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/RAKL/schemas/closest-parent-ablation-suite-v1.schema.json",
  "title": "RAKL closest-parent ablation suite v1",
  "description": "Closest-parent ablation suite inventory for Paper II novelty defense (issue #156). Proposal-only; no novelty claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "issue",
    "reasons",
    "grants_scientific_authority",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "closest-parent-ablation-suite-v1"},
    "status": {
      "enum": ["STUB_FROZEN", "PROTOCOL_FROZEN", "INSUFFICIENT_EVIDENCE", "CANNOT_CHECK"]
    },
    "issue": {"type": "integer", "minimum": 1},
    "reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "grants_scientific_authority": {"const": false},
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
